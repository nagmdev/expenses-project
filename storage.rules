rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasVerifiedEmail() {
      return request.auth.token.get('email_verified', false) == true &&
        request.auth.token.get('email', null) is string &&
        request.auth.token.email != '';
    }

    function verifiedEmail() {
      return request.auth.token.email.lower();
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        firestore.exists(/databases/(default)/documents/super_admins/$(request.auth.uid)) ||
        (hasVerifiedEmail() && (
          firestore.exists(/databases/(default)/documents/super_admins/$(verifiedEmail())) ||
          verifiedEmail() == 'mahmoud@tieapps.com'
        ))
      );
    }

    function profilePath() {
      return /databases/(default)/documents/users/$(request.auth.uid);
    }

    function ownMemberPath(orgId) {
      return /databases/(default)/documents/members/$(request.auth.uid + '_' + orgId);
    }

    function inOrgViaProfile(orgId) {
      return firestore.exists(profilePath()) &&
        firestore.get(profilePath()).data.get('orgId', null) == orgId &&
        firestore.get(profilePath()).data.get('active', true) != false;
    }

    function inOrgViaMember(orgId) {
      return firestore.exists(ownMemberPath(orgId)) &&
        firestore.get(ownMemberPath(orgId)).data.get('orgId', null) == orgId &&
        firestore.get(ownMemberPath(orgId)).data.get('active', true) != false;
    }

    function hasOrgRole(orgId, roles) {
      return (inOrgViaProfile(orgId) && firestore.get(profilePath()).data.get('role', null) in roles) ||
        (inOrgViaMember(orgId) && firestore.get(ownMemberPath(orgId)).data.get('role', null) in roles);
    }

    function isOrgMember(orgId) {
      return isSuperAdmin() || (isAuthenticated() && (inOrgViaProfile(orgId) || inOrgViaMember(orgId)));
    }

    function canReadAttachment(orgId) {
      return isSuperAdmin() || (
        isAuthenticated() && (
          hasOrgRole(orgId, ['org_admin', 'finance']) ||
          (isOrgMember(orgId) && resource.metadata != null && resource.metadata.get('uploaderUid', '') == request.auth.uid) ||
          (isOrgMember(orgId) && (resource.metadata == null || !('uploaderUid' in resource.metadata)))
        )
      );
    }

    function canDeleteAttachment(orgId) {
      return isSuperAdmin() || (
        isAuthenticated() && (
          hasOrgRole(orgId, ['org_admin', 'finance']) ||
          (isOrgMember(orgId) && resource.metadata != null && resource.metadata.get('uploaderUid', '') == request.auth.uid)
        )
      );
    }

    match /invoices/{orgId}/{fileName} {
      allow read: if canReadAttachment(orgId);
      allow create, update: if isOrgMember(orgId) &&
        orgId != '' &&
        orgId != 'org-main' &&
        request.resource.size < 15 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf') &&
        (request.resource.metadata == null || request.resource.metadata.get('uploaderUid', '') == request.auth.uid);
      allow delete: if canDeleteAttachment(orgId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
