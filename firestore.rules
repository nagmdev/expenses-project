rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS & RBAC ENFORCEMENT
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    // Anyone can create an email/password account for an address they do not own
    // (the provider is enabled for admin provisioning), so an email only proves
    // identity once Firebase has verified it. Google sign-in emails are verified.
    function hasVerifiedEmail() {
      return request.auth.token.get('email_verified', false) == true &&
        request.auth.token.get('email', null) is string &&
        request.auth.token.email != '';
    }

    // Only call after hasVerifiedEmail().
    function verifiedEmail() {
      return request.auth.token.email.lower();
    }

    // The ONLY built-in platform owner. Keep identical to DEFAULT_SUPER_ADMINS in
    // src/context/AppContext.tsx. Other super admins exist only as super_admins/{uid}
    // or super_admins/{verified email} records created by a super admin.
    function builtInSuperAdmins() {
      return ['mahmoud@tieapps.com'];
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/super_admins/$(request.auth.uid)) ||
        (hasVerifiedEmail() && (
          exists(/databases/$(database)/documents/super_admins/$(verifiedEmail())) ||
          verifiedEmail() in builtInSuperAdmins()
        ))
      );
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function ownMemberPath(orgId) {
      return /databases/$(database)/documents/members/$(request.auth.uid + '_' + orgId);
    }

    // users/{uid} holds the caller's primary org and their role in THAT org only.
    // A suspended profile (active: false) grants nothing.
    function inOrgViaProfile(orgId) {
      return exists(profilePath()) &&
        get(profilePath()).data.get('orgId', null) == orgId &&
        get(profilePath()).data.get('active', true) != false;
    }

    // members/{uid}_{orgId} holds the caller's role in orgId. The orgId field is
    // checked as well as the document id, so an id that names another org grants nothing.
    // A suspended membership (active: false) grants nothing.
    function inOrgViaMember(orgId) {
      return exists(ownMemberPath(orgId)) &&
        get(ownMemberPath(orgId)).data.get('orgId', null) == orgId &&
        get(ownMemberPath(orgId)).data.get('active', true) != false;
    }

    // A role held in one org never applies to another org.
    function hasOrgRole(orgId, roles) {
      return (inOrgViaProfile(orgId) && get(profilePath()).data.get('role', null) in roles) ||
        (inOrgViaMember(orgId) && get(ownMemberPath(orgId)).data.get('role', null) in roles);
    }

    function isOrgMember(orgId) {
      return isSuperAdmin() || (isAuthenticated() && (inOrgViaProfile(orgId) || inOrgViaMember(orgId)));
    }

    function isOrgAdmin(orgId) {
      return isSuperAdmin() || (isAuthenticated() && hasOrgRole(orgId, ['org_admin']));
    }

    // Data-entry staff maintain their company's directory (providers, departments).
    function isDataEntry(orgId) {
      return isAuthenticated() && hasOrgRole(orgId, ['data_entry']);
    }

    function isFinance(orgId) {
      return isSuperAdmin() || (isAuthenticated() && hasOrgRole(orgId, ['finance', 'org_admin']));
    }

    // A record another company shares with the caller's company (a service's orgIds, set by
    // the platform owner only). The caller's company is the one of their active profile, so a
    // query where('orgIds', 'array-contains', <that company>) can be proven against this.
    function inSharedOrgViaProfile(orgIds) {
      return isAuthenticated() && exists(profilePath()) &&
        get(profilePath()).data.get('active', true) != false &&
        get(profilePath()).data.get('orgId', '') is string &&
        get(profilePath()).data.get('orgId', '') != '' &&
        get(profilePath()).data.get('orgId', '') in orgIds;
    }

    function hasSharedOrgRole(orgIds, roles) {
      return inSharedOrgViaProfile(orgIds) && get(profilePath()).data.get('role', null) in roles;
    }

    // Payout details (bank, IBAN, InstaPay, wallet) belong in users/{uid} only: members/*
    // can be listed by every member of the company.
    function payoutKeys() {
      return ['instapay', 'wallet', 'walletProvider', 'bankName', 'iban'];
    }

    // None may be added to or changed in a membership (removing ones an older version copied is fine).
    function noPayoutAddedOrChanged() {
      return !request.resource.data.diff(resource.data).addedKeys().hasAny(payoutKeys()) &&
        !request.resource.data.diff(resource.data).changedKeys().hasAny(payoutKeys());
    }

    // The fields that decide what a membership grants, and to whom (grantsMembership trusts them).
    function grantFields() {
      return ['role', 'orgId', 'userId', 'userEmail', 'active'];
    }

    // The platform owner's membership, and the caller's own: an org admin can neither delete
    // them nor change what they grant. Only a super admin can (src/domain/directory.ts ->
    // membershipProtection).
    function isProtectedMembership(m) {
      return m.get('userId', null) == request.auth.uid || (
        m.get('userEmail', null) is string && (
          m.userEmail.lower() in builtInSuperAdmins() ||
          (hasVerifiedEmail() && m.userEmail.lower() == verifiedEmail())
        )
      );
    }

    // members/{memberId} records that an admin of orgId gave the caller `role` there:
    // same org and role, not suspended, and addressed either to the caller's UID or to
    // the caller's verified email (members invited by email before their first
    // sign-in). Member documents are written only by admins of their org (see
    // /members), so this cannot be forged. The id is taken from the caller, which is
    // why legacy placeholder ids (pending-<base64>, temp_…, usr-…) keep working.
    function grantsMembership(memberId, orgId, role) {
      return memberId is string && memberId.matches('[^/]+') &&
        orgId is string && orgId != '' &&
        role in ['org_admin', 'finance', 'data_entry', 'employee'] &&
        exists(/databases/$(database)/documents/members/$(memberId)) &&
        isGrantFor(get(/databases/$(database)/documents/members/$(memberId)).data, orgId, role);
    }

    function isGrantFor(member, orgId, role) {
      return member.get('orgId', null) == orgId &&
        member.get('role', null) == role &&
        member.get('active', true) != false && (
          member.get('userId', null) == request.auth.uid ||
          (hasVerifiedEmail() && member.get('userEmail', null) == verifiedEmail())
        );
    }

    function sameField(after, before, field, fallback) {
      return after.get(field, fallback) == before.get(field, fallback);
    }

    // A user may write their own users/{uid} profile (name, phone, payout details…),
    // but the fields that grant access may only take values an admin granted:
    //  - role / orgId / active: unchanged; or no org at all (a bare profile grants
    //    nothing); or exactly the membership named in memberId (self-link on first
    //    sign-in, see forceRefreshUserState).
    //  - email: unchanged, or the caller's own verified address. Admin tooling looks
    //    profiles up by email, so nobody may claim someone else's address.
    // `before` is {} on create.
    function isOwnProfileWrite(userId, before) {
      let after = request.resource.data;
      return isAuthenticated() && request.auth.uid == userId && (
        sameField(after, before, 'email', null) ||
        (hasVerifiedEmail() && after.get('email', null) == verifiedEmail())
      ) && (
        (sameField(after, before, 'role', null) && sameField(after, before, 'orgId', null) && sameField(after, before, 'active', true)) ||
        (after.get('orgId', null) in [null, ''] && after.get('role', 'employee') == 'employee') ||
        (after.get('active', true) == true && grantsMembership(after.get('memberId', null), after.get('orgId', null), after.get('role', null)))
      );
    }

    // Idempotent creates read the target document inside a transaction first
    // ("does this operation already exist?"). Reading a document that does not
    // exist reveals nothing, so a single-document GET of a missing doc is allowed.
    function isMissing() {
      return resource == null;
    }

    // Company staff may edit their company's documents but never move one into another
    // company (that would inject data into, or steal it from, a tenant they don't run).
    function orgUnchanged() {
      return request.resource.data.get('orgId', null) == resource.data.get('orgId', null);
    }

    // Default deny for unhandled collections
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // 1. SUPER ADMINS (System Management)
    // =========================================================================
    match /super_admins/{adminId} {
      // The list (with each admin's contact and payout details) is for super admins
      // only; anyone may read the record about themselves.
      allow get: if isAuthenticated() && (
        isSuperAdmin() ||
        adminId == request.auth.uid ||
        (hasVerifiedEmail() && adminId == verifiedEmail())
      );
      allow list: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 2. USERS (Profiles & Security Metadata)
    // =========================================================================
    match /users/{userId} {
      allow get: if isAuthenticated() && (isMissing() || request.auth.uid == userId || isSuperAdmin() || (resource.data.orgId != null && isOrgAdmin(resource.data.orgId)));
      allow list: if isAuthenticated() && (isSuperAdmin() || (resource.data.orgId != null && isOrgAdmin(resource.data.orgId)));
      // Self-writes never grant a role or org the caller was not given (isOwnProfileWrite).
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        isOwnProfileWrite(userId, {}) ||
        (isOrgAdmin(request.resource.data.orgId) && request.resource.data.role != 'super_admin')
      );
      // Org admins manage profiles in their org, and may detach one from it (member
      // removed: org cleared, role reset), but never move a profile to another org.
      allow update: if isSuperAdmin() || (
        isOrgAdmin(resource.data.orgId) &&
        request.resource.data.role != 'super_admin' && (
          request.resource.data.orgId == resource.data.orgId ||
          (request.resource.data.get('orgId', null) in [null, ''] && request.resource.data.get('role', 'employee') == 'employee')
        )
      ) || isOwnProfileWrite(userId, resource.data);
      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 3. ORGANIZATIONS (Tenant Isolation)
    // =========================================================================
    match /organizations/{orgId} {
      allow get: if isAuthenticated() && (isMissing() || isSuperAdmin() || isOrgMember(orgId));
      allow list: if isAuthenticated() && (isSuperAdmin() || isOrgMember(orgId));
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || isOrgAdmin(orgId);
      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 4. MEMBERS (Company Users & RBAC)
    // =========================================================================
    match /members/{memberId} {
      allow get: if isAuthenticated() && (
        isMissing() ||
        isSuperAdmin() ||
        resource.data.userId == request.auth.uid ||
        (request.auth.token.email != null && resource.data.userEmail == request.auth.token.email) ||
        isOrgMember(resource.data.orgId)
      );
      allow list: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.userId == request.auth.uid ||
        (request.auth.token.email != null && resource.data.userEmail == request.auth.token.email) ||
        isOrgMember(resource.data.orgId)
      );
      // The id is always <userId>_<orgId> (the rules look memberships up by that id).
      allow create: if isSuperAdmin() || (isOrgAdmin(request.resource.data.orgId) &&
        request.resource.data.role != 'super_admin' &&
        memberId == request.resource.data.userId + '_' + request.resource.data.orgId &&
        !request.resource.data.keys().hasAny(payoutKeys()));
      allow update: if isSuperAdmin() || (
        isOrgAdmin(resource.data.orgId) &&
        request.resource.data.role != 'super_admin' &&
        request.resource.data.orgId == resource.data.orgId &&
        noPayoutAddedOrChanged() &&
        // The owner's and the admin's own membership: name / contact only, never role or status.
        (!isProtectedMembership(resource.data) ||
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(grantFields()))
      ) || (
        // Self-service edits of contact details only. Who the membership belongs to
        // (userId, userEmail) and what it grants (role, orgId, active) are admin-only:
        // grantsMembership() trusts these fields. Payout details go to users/{uid}.
        isAuthenticated() && resource.data.userId == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(grantFields()) &&
        noPayoutAddedOrChanged()
      );
      allow delete: if isSuperAdmin() || (isOrgAdmin(resource.data.orgId) && !isProtectedMembership(resource.data));
    }

    // =========================================================================
    // 5. SERVICES & CATEGORIES
    // =========================================================================
    match /services/{serviceId} {
      // Sharing a service with other companies (orgIds) is the platform owner's call: company
      // staff name no company but their own, and keep an existing list as it is.
      function sharingOwnOnly() {
        return request.resource.data.get('orgIds', []).size() == 0 ||
          request.resource.data.get('orgIds', []) == [request.resource.data.orgId];
      }
      function sharingUnchangedOrOwn() {
        return request.resource.data.get('orgIds', null) == resource.data.get('orgIds', null) || sharingOwnOnly();
      }

      // Readable in its own company and in every company it is shared with.
      allow get: if isAuthenticated() && (isMissing() || isSuperAdmin() || isOrgMember(resource.data.orgId) ||
        inSharedOrgViaProfile(resource.data.get('orgIds', [])));
      allow list: if isAuthenticated() && (isSuperAdmin() || isOrgMember(resource.data.orgId) ||
        inSharedOrgViaProfile(resource.data.get('orgIds', [])));
      allow create: if isSuperAdmin() || (isOrgAdmin(request.resource.data.orgId) && sharingOwnOnly());
      allow update: if isSuperAdmin() ||
        ((isOrgAdmin(resource.data.orgId) || isFinance(resource.data.orgId)) && orgUnchanged() && sharingUnchangedOrOwn()) ||
        // Finance of a company the service is shared with: paying a request adds to its
        // spending (disburseExpenseRequest) - nothing else, and never downwards.
        (hasSharedOrgRole(resource.data.get('orgIds', []), ['finance', 'org_admin']) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['spentAmount', 'updatedAt']) &&
          request.resource.data.get('spentAmount', 0) >= resource.data.get('spentAmount', 0));
      allow delete: if isSuperAdmin() || isOrgAdmin(resource.data.orgId);
    }

    // =========================================================================
    // 6. PROVIDERS & VENDORS
    // =========================================================================
    match /providers/{providerId} {
      allow get: if isAuthenticated() && (isMissing() || isSuperAdmin() || isOrgMember(resource.data.orgId));
      allow list: if isAuthenticated() && (isSuperAdmin() || isOrgMember(resource.data.orgId));
      // Data entry may add a provider to its own company, always starting with no payments.
      allow create: if isSuperAdmin() || isOrgAdmin(request.resource.data.orgId) ||
        (isDataEntry(request.resource.data.orgId) && request.resource.data.get('totalPaid', 0) == 0);
      allow update: if isSuperAdmin() || ((isOrgAdmin(resource.data.orgId) || isFinance(resource.data.orgId)) && orgUnchanged());
      allow delete: if isSuperAdmin() || isOrgAdmin(resource.data.orgId);
    }

    // =========================================================================
    // 7. DEPARTMENTS
    // =========================================================================
    match /departments/{deptId} {
      allow get: if isAuthenticated() && (isMissing() || isSuperAdmin() || isOrgMember(resource.data.orgId));
      allow list: if isAuthenticated() && (isSuperAdmin() || isOrgMember(resource.data.orgId));
      // (create previously evaluated resource.data on a missing doc → only super admins could create)
      allow create: if isSuperAdmin() || isOrgAdmin(request.resource.data.orgId) || isDataEntry(request.resource.data.orgId);
      allow update: if isSuperAdmin() || (isOrgAdmin(resource.data.orgId) && orgUnchanged());
      allow delete: if isSuperAdmin() || isOrgAdmin(resource.data.orgId);
    }

    // =========================================================================
    // 8. EXPENSE REQUESTS (Strict State Machine)
    // =========================================================================
    match /requests/{requestId} {
      function canReadRequest() {
        return isSuperAdmin() ||
          isOrgAdmin(resource.data.orgId) ||
          isFinance(resource.data.orgId) ||
          resource.data.requesterId == request.auth.uid ||
          resource.data.requesterEmail == request.auth.token.email;
      }
      function isRequester() {
        return resource.data.requesterId == request.auth.uid || resource.data.requesterEmail == request.auth.token.email;
      }

      allow get: if isAuthenticated() && (isMissing() || canReadRequest());
      allow list: if isAuthenticated() && canReadRequest();

      // Create: strictly pending, authenticated member of the organization
      // The platform owner may also create a request in any state: restoring records the
      // old app version kept only in a browser (src/domain/legacyRecovery.ts).
      allow create: if isSuperAdmin() || (isAuthenticated() &&
        isOrgMember(request.resource.data.orgId) &&
        request.resource.data.status == 'pending' &&
        (request.resource.data.requesterId == request.auth.uid || isOrgAdmin(request.resource.data.orgId)));

      // Update: strictly guarded transitions. 'disbursed' is terminal (money has moved).
      allow update: if isAuthenticated() && (
        isSuperAdmin() || (orgUnchanged() && (
        // Org Admin & Finance: approve / reject / clarify / edit — never touch a disbursed request
        ((isOrgAdmin(resource.data.orgId) || isFinance(resource.data.orgId)) &&
          resource.data.status != 'disbursed' &&
          request.resource.data.status in ['approved', 'rejected', 'clarification_requested', 'pending']
        ) ||
        // Finance: disburse ONLY IF status is currently approved (or pending for income receipt)
        (isFinance(resource.data.orgId) &&
          request.resource.data.status == 'disbursed' && (
            resource.data.status == 'approved' ||
            (resource.data.requestType == 'income' && resource.data.status == 'pending')
          )
        ) ||
        // Requester: reply to a clarification (amount unchanged)
        (isRequester() &&
          resource.data.status == 'clarification_requested' &&
          request.resource.data.status == 'pending' &&
          request.resource.data.amount == resource.data.amount
        ) ||
        // Requester: edit own request while it is still under review (status unchanged)
        (isRequester() &&
          resource.data.status in ['pending', 'clarification_requested'] &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.requesterId == resource.data.requesterId
        )
      )));

      allow delete: if isSuperAdmin() || isOrgAdmin(resource.data.orgId);
    }

    // =========================================================================
    // 8b. VISA REQUESTS (previously had no rule → every write was denied)
    // =========================================================================
    match /visaRequests/{visaId} {
      function canReadVisa() {
        return isSuperAdmin() || isFinance(resource.data.orgId) || resource.data.requesterId == request.auth.uid;
      }
      allow get: if isAuthenticated() && (isMissing() || canReadVisa());
      allow list: if isAuthenticated() && canReadVisa();
      // Super admin: any state (restoring visa requests that the old version never saved).
      allow create: if isSuperAdmin() ||
        (isAuthenticated() && isOrgMember(request.resource.data.orgId) && request.resource.data.status == 'pending' &&
          (request.resource.data.requesterId == request.auth.uid || isOrgAdmin(request.resource.data.orgId)));
      allow update: if isSuperAdmin() || (isFinance(resource.data.orgId) && orgUnchanged());
      allow delete: if isSuperAdmin() || isOrgAdmin(resource.data.orgId);
    }

    // =========================================================================
    // 9. PAYMENT ACCOUNTS & TREASURY VAULTS
    // =========================================================================
    match /paymentAccounts/{accountId} {
      // An account with a balance or any history (opening balance, money in or out) is part
      // of the books: it can be deactivated, never deleted (domain: assertPaymentAccountDeletable).
      function hasNoHistory() {
        return resource.data.get('currentBalance', 0) in [0, null] &&
          resource.data.get('balance', 0) in [0, null] &&
          resource.data.get('initialBalance', 0) in [0, null] &&
          resource.data.get('totalIn', 0) in [0, null] &&
          resource.data.get('totalOut', 0) in [0, null];
      }
      allow get: if isAuthenticated() && (isMissing() || isSuperAdmin() || isFinance(resource.data.orgId));
      allow list: if isAuthenticated() && (isSuperAdmin() || isFinance(resource.data.orgId));
      allow create: if isSuperAdmin() || isOrgAdmin(request.resource.data.orgId);
      allow update: if isSuperAdmin() || (isFinance(resource.data.orgId) && orgUnchanged());
      allow delete: if hasNoHistory() && (isSuperAdmin() || isOrgAdmin(resource.data.orgId));
    }

    // =========================================================================
    // 10. ACCOUNT TRANSACTIONS (Financial Ledger - Immutable)
    // =========================================================================
    match /accountTransactions/{txId} {
      allow get: if isAuthenticated() && (isMissing() || isSuperAdmin() || isFinance(resource.data.orgId));
      allow list: if isAuthenticated() && (isSuperAdmin() || isFinance(resource.data.orgId));
      allow create: if isSuperAdmin() || isFinance(request.resource.data.orgId);
      allow update, delete: if isSuperAdmin(); // Financial ledgers cannot be modified by standard users
    }

    // =========================================================================
    // 11. PETTY CASH & CUSTODIES
    // =========================================================================
    match /custodies/{custodyId} {
      function canReadCustody() {
        return isSuperAdmin() ||
          isFinance(resource.data.orgId) ||
          resource.data.employeeId == request.auth.uid ||
          (resource.data.get('employeeEmail', '') != '' && resource.data.employeeEmail == request.auth.token.email) ||
          (isOrgMember(resource.data.orgId) &&
           exists(/databases/$(database)/documents/members/$(request.auth.uid + '_' + resource.data.orgId)) &&
           get(/databases/$(database)/documents/members/$(request.auth.uid + '_' + resource.data.orgId)).data.userName == resource.data.employeeName);
      }
      allow get: if isAuthenticated() && (isMissing() || canReadCustody());
      allow list: if isAuthenticated() && canReadCustody();
      allow create: if isSuperAdmin() || isFinance(request.resource.data.orgId);
      allow update: if isSuperAdmin() || (isFinance(resource.data.orgId) && orgUnchanged()) || (
        (
          resource.data.employeeId == request.auth.uid ||
          (resource.data.get('employeeEmail', '') != '' && resource.data.employeeEmail == request.auth.token.email) ||
          (isOrgMember(resource.data.orgId) &&
           exists(/databases/$(database)/documents/members/$(request.auth.uid + '_' + resource.data.orgId)) &&
           get(/databases/$(database)/documents/members/$(request.auth.uid + '_' + resource.data.orgId)).data.userName == resource.data.employeeName)
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['remainingAmount', 'settledAmount', 'status', 'settledAt', 'updatedAt']) &&
        request.resource.data.employeeId == resource.data.employeeId &&
        request.resource.data.totalAmount == resource.data.totalAmount &&
        request.resource.data.orgId == resource.data.orgId &&
        request.resource.data.currency == resource.data.currency &&
        request.resource.data.sourceAccountId == resource.data.sourceAccountId &&
        request.resource.data.custodyNumber == resource.data.custodyNumber &&
        request.resource.data.remainingAmount >= 0 &&
        request.resource.data.remainingAmount <= resource.data.remainingAmount &&
        request.resource.data.settledAmount >= resource.data.settledAmount &&
        request.resource.data.totalAmount == request.resource.data.remainingAmount + request.resource.data.settledAmount + resource.data.get('returnedAmount', 0) &&
        (request.resource.data.status == resource.data.status || (request.resource.data.remainingAmount == 0 && request.resource.data.status == 'settled'))
      );
      allow delete: if isSuperAdmin();
    }

    match /pettyCashCustodies/{custodyId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        isFinance(resource.data.orgId) ||
        resource.data.employeeId == request.auth.uid ||
        (resource.data.get('employeeEmail', '') != '' && resource.data.employeeEmail == request.auth.token.email) ||
        (isOrgMember(resource.data.orgId) &&
         exists(/databases/$(database)/documents/members/$(request.auth.uid + '_' + resource.data.orgId)) &&
         get(/databases/$(database)/documents/members/$(request.auth.uid + '_' + resource.data.orgId)).data.userName == resource.data.employeeName)
      );
      allow create: if isSuperAdmin() || isFinance(request.resource.data.orgId);
      allow update: if isSuperAdmin() || (isFinance(resource.data.orgId) && orgUnchanged()) || (
        (
          resource.data.employeeId == request.auth.uid ||
          (resource.data.get('employeeEmail', '') != '' && resource.data.employeeEmail == request.auth.token.email) ||
          (isOrgMember(resource.data.orgId) &&
           exists(/databases/$(database)/documents/members/$(request.auth.uid + '_' + resource.data.orgId)) &&
           get(/databases/$(database)/documents/members/$(request.auth.uid + '_' + resource.data.orgId)).data.userName == resource.data.employeeName)
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['remainingAmount', 'settledAmount', 'status', 'settledAt', 'updatedAt']) &&
        request.resource.data.employeeId == resource.data.employeeId &&
        request.resource.data.totalAmount == resource.data.totalAmount &&
        request.resource.data.orgId == resource.data.orgId &&
        request.resource.data.currency == resource.data.currency &&
        request.resource.data.sourceAccountId == resource.data.sourceAccountId &&
        request.resource.data.custodyNumber == resource.data.custodyNumber &&
        request.resource.data.remainingAmount >= 0 &&
        request.resource.data.remainingAmount <= resource.data.remainingAmount &&
        request.resource.data.settledAmount >= resource.data.settledAmount &&
        request.resource.data.totalAmount == request.resource.data.remainingAmount + request.resource.data.settledAmount + resource.data.get('returnedAmount', 0) &&
        (request.resource.data.status == resource.data.status || (request.resource.data.remainingAmount == 0 && request.resource.data.status == 'settled'))
      );
      allow delete: if isSuperAdmin();
    }

    match /custodySettlements/{settlementId} {
      function canReadSettlement() {
        return isSuperAdmin() ||
          isFinance(resource.data.orgId) ||
          resource.data.employeeId == request.auth.uid ||
          (resource.data.get('employeeEmail', '') != '' && resource.data.employeeEmail == request.auth.token.email) ||
          (isOrgMember(resource.data.orgId) &&
           exists(/databases/$(database)/documents/members/$(request.auth.uid + '_' + resource.data.orgId)) &&
           get(/databases/$(database)/documents/members/$(request.auth.uid + '_' + resource.data.orgId)).data.userName == resource.data.employeeName);
      }
      allow get: if isAuthenticated() && (isMissing() || canReadSettlement());
      allow list: if isAuthenticated() && canReadSettlement();
      // An employee may only file an invoice against THEIR OWN custody, in its company.
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        isFinance(request.resource.data.orgId) ||
        (
          isOrgMember(request.resource.data.orgId) &&
          request.resource.data.custodyId is string &&
          exists(/databases/$(database)/documents/custodies/$(request.resource.data.custodyId)) &&
          get(/databases/$(database)/documents/custodies/$(request.resource.data.custodyId)).data.orgId == request.resource.data.orgId &&
          request.resource.data.amount > 0 &&
          request.resource.data.amount <= get(/databases/$(database)/documents/custodies/$(request.resource.data.custodyId)).data.remainingAmount &&
          (
            request.resource.data.employeeId == request.auth.uid ||
            (request.resource.data.get('employeeEmail', '') != '' && request.resource.data.employeeEmail == request.auth.token.email) ||
            request.resource.data.employeeId == get(/databases/$(database)/documents/custodies/$(request.resource.data.custodyId)).data.employeeId
          ) &&
          (
            get(/databases/$(database)/documents/custodies/$(request.resource.data.custodyId)).data.employeeId == request.auth.uid ||
            (get(/databases/$(database)/documents/custodies/$(request.resource.data.custodyId)).data.get('employeeEmail', '') != '' &&
             get(/databases/$(database)/documents/custodies/$(request.resource.data.custodyId)).data.employeeEmail == request.auth.token.email) ||
            (exists(/databases/$(database)/documents/members/$(request.auth.uid + '_' + request.resource.data.orgId)) &&
             get(/databases/$(database)/documents/members/$(request.auth.uid + '_' + request.resource.data.orgId)).data.userName == get(/databases/$(database)/documents/custodies/$(request.resource.data.custodyId)).data.employeeName)
          )
        )
      );
      allow update: if isSuperAdmin() || (isFinance(resource.data.orgId) && orgUnchanged());
      allow delete: if isSuperAdmin() || isFinance(resource.data.orgId);
    }

    // =========================================================================
    // 12. AUDIT LOGS & EMAIL LOGS (Append-Only)
    // =========================================================================
    match /auditLogs/{logId} {
      allow get: if isAuthenticated() && (isMissing() || isSuperAdmin() || isOrgAdmin(resource.data.orgId));
      allow list: if isAuthenticated() && (isSuperAdmin() || isOrgAdmin(resource.data.orgId));
      // An entry can only be written in the caller's own name (no forged actors).
      allow create: if isAuthenticated() && request.resource.data.actorId == request.auth.uid &&
        (request.resource.data.get('orgId', '') == '' || isOrgMember(request.resource.data.orgId));
      allow update, delete: if isSuperAdmin();
    }

    match /email_logs/{logId} {
      allow read, write: if isAuthenticated() && isSuperAdmin();
    }

    // =========================================================================
    // 13. ATOMIC SEQUENCES (request / custody / visa numbers)
    //     Can only ever move forward by exactly one → numbers are never reissued.
    // =========================================================================
    match /counters/{counterId} {
      allow get: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.value == 1 && (
        isSuperAdmin() ||
        (counterId.matches('^(custodies|transfers)-[0-9]{4}$') && (
          exists(profilePath()) && (
            get(profilePath()).data.get('role', '') in ['finance', 'org_admin'] ||
            hasOrgRole(get(profilePath()).data.get('orgId', ''), ['finance', 'org_admin'])
          )
        )) ||
        (counterId.matches('^(requests|visa)-[0-9]{4}$') && (
          exists(profilePath()) && get(profilePath()).data.get('active', true) != false && get(profilePath()).data.get('orgId', '') != ''
        ))
      );
      allow update: if isAuthenticated() && request.resource.data.value == resource.data.value + 1 && (
        isSuperAdmin() ||
        (counterId.matches('^(custodies|transfers)-[0-9]{4}$') && (
          exists(profilePath()) && (
            get(profilePath()).data.get('role', '') in ['finance', 'org_admin'] ||
            hasOrgRole(get(profilePath()).data.get('orgId', ''), ['finance', 'org_admin'])
          )
        )) ||
        (counterId.matches('^(requests|visa)-[0-9]{4}$') && (
          exists(profilePath()) && get(profilePath()).data.get('active', true) != false && get(profilePath()).data.get('orgId', '') != ''
        ))
      );
      allow delete: if false;
    }

    // =========================================================================
    // 14. UNIQUENESS REGISTRY (Firestore has no UNIQUE constraint)
    //     One document per unique value (account number, service code, member email…)
    // =========================================================================
    match /uniqueKeys/{keyId} {
      // The id is <scope>__<company id>__<value> (src/domain/common.ts → uniqueKeyDocId).
      function keyOrgId() {
        return keyId.split('__')[1];
      }
      function inKeyCompany() {
        return keyId.split('__').size() >= 2 && keyOrgId() != '-' && isOrgMember(keyOrgId());
      }
      // A key names a record of its company (e.g. a member's email and id). Readable by that
      // company's members only, whether it exists or not: an answer that differed between a
      // missing and an existing key would tell anyone which emails, providers or account
      // numbers another company has. Company-less keys (org codes) and keys in the old id
      // format (company id encoded) are read by the platform owner only.
      allow get: if isAuthenticated() && (isSuperAdmin() || inKeyCompany());
      allow create: if isAuthenticated() && request.resource.data.entityId is string && (
        isSuperAdmin() || (request.resource.data.orgId != '-' && request.resource.data.orgId == keyOrgId() && inKeyCompany())
      );
      allow update: if false;
      allow delete: if isAuthenticated() && (
        isSuperAdmin() || (
          resource.data.orgId != '-' &&
          isOrgAdmin(resource.data.orgId) &&
          resource.data.entityCollection is string &&
          resource.data.entityId is string &&
          !exists(/databases/$(database)/documents/$(resource.data.entityCollection)/$(resource.data.entityId))
        )
      );
    }

    // =========================================================================
    // 15. NOTIFICATION OUTBOX (email / webhook delivery with retries)
    // =========================================================================
    match /outbox/{eventId} {
      function canManageOutbox() {
        return isSuperAdmin() || resource.data.createdBy == request.auth.uid ||
          (resource.data.orgId != '' && isFinance(resource.data.orgId));
      }
      // eventId = <eventType>__<entityId>[__<operationKey>] (see outboxEventId), or
      // test_email__<key> for a settings-page test email.
      function idParts() {
        return eventId.split('__');
      }

      // Where an org's admin-facing notifications may go: its active org admins
      // (organizations/{orgId}.notificationRecipients, maintained with memberships) and
      // the platform super admins (system_settings/notification_recipients + built-ins).
      function adminRecipients(orgId) {
        return get(/databases/$(database)/documents/organizations/$(orgId)).data.get('notificationRecipients', [])
          .concat(builtInSuperAdmins())
          .concat(exists(/databases/$(database)/documents/system_settings/notification_recipients)
            ? get(/databases/$(database)/documents/system_settings/notification_recipients).data.get('emails', [])
            : []);
      }

      // The request as it will be after this write (created / updated in the same transaction).
      function requestAfter(e) {
        return getAfter(/databases/$(database)/documents/requests/$(e.entityId)).data;
      }

      function requesterEmailOf(req) {
        return req.get('requesterEmail', '').trim().lower();
      }

      function isRequesterOf(req) {
        return req.get('requesterId', null) == request.auth.uid ||
          (hasVerifiedEmail() && requesterEmailOf(req) == verifiedEmail());
      }

      // Each request event is bound to a request of the same org, raised by the party
      // the workflow allows, and addressed only to the people that event notifies.
      function isRequestEvent(e) {
        return e.entityType == 'request' && e.entityId is string &&
          idParts()[0] == e.eventType && idParts()[1] == e.entityId &&
          existsAfter(/databases/$(database)/documents/requests/$(e.entityId)) &&
          requestAfter(e).get('orgId', null) == e.orgId && (
            (e.eventType == 'new_request' && idParts().size() == 2 &&
              requestAfter(e).get('requesterId', null) == request.auth.uid &&
              e.recipients.hasOnly(adminRecipients(e.orgId))) ||
            (e.eventType == 'clarification_replied' && idParts().size() == 3 &&
              isRequesterOf(requestAfter(e)) &&
              e.recipients.hasOnly(adminRecipients(e.orgId))) ||
            (e.eventType in ['request_approved', 'request_rejected', 'clarification_requested'] && idParts().size() == 3 &&
              isFinance(e.orgId) &&
              e.recipients == [requesterEmailOf(requestAfter(e))]) ||
            (e.eventType == 'request_paid' && idParts().size() == 2 &&
              isFinance(e.orgId) &&
              e.recipients == [requesterEmailOf(requestAfter(e))])
          );
      }

      // Settings-page test email: org admins, to their org's admin recipients or themselves.
      function isTestEvent(e) {
        return e.entityType == 'system' && e.entityId == 'test' &&
          idParts()[0] == 'test_email' && idParts().size() == 2 &&
          isOrgAdmin(e.orgId) &&
          e.recipients.hasOnly(adminRecipients(e.orgId).concat(hasVerifiedEmail() ? [verifiedEmail()] : []));
      }

      allow get: if isAuthenticated() && (isMissing() || canManageOutbox());
      allow list: if isAuthenticated() && (isSuperAdmin() || (resource.data.orgId != '' && isFinance(resource.data.orgId)));
      allow create: if isAuthenticated() &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.get('attempts', 0) == 0 &&
        request.resource.data.get('maxAttempts', 0) <= 10 &&
        (isSuperAdmin() || (
          request.resource.data.orgId is string && request.resource.data.orgId != '' &&
          isOrgMember(request.resource.data.orgId) &&
          request.resource.data.recipients is list &&
          request.resource.data.recipients.size() > 0 && request.resource.data.recipients.size() <= 50 &&
          (isRequestEvent(request.resource.data) || isTestEvent(request.resource.data))
        ));
      // Delivery-state transitions only (everything else is immutable), never out of a
      // terminal state, and each claim adds exactly one attempt, so an event is
      // delivered at most maxAttempts + 1 times.
      allow update: if isAuthenticated() && canManageOutbox() &&
        !(resource.data.status in ['sent', 'dead']) &&
        request.resource.data.status in ['sending', 'sent', 'failed', 'dead'] &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'attempts', 'leaseUntil', 'nextAttemptAt', 'lastError', 'deliveredTo', 'sentAt', 'updatedAt']) &&
        (request.resource.data.get('attempts', 0) == resource.data.get('attempts', 0) ||
          (request.resource.data.status == 'sending' &&
            request.resource.data.get('attempts', 0) == resource.data.get('attempts', 0) + 1)) &&
        request.resource.data.get('attempts', 0) <= resource.data.get('maxAttempts', 6) + 1;
      allow delete: if isSuperAdmin();
    }

    // Trigger-Email extension queue. A mail document is only ever the delivery of one
    // recipient of an outbox event currently claimed for sending: same recipient,
    // content and sender as the event, deterministic id, no cc/bcc/attachments.
    match /mail/{mailId} {
      function outboxPath(eventId) {
        return /databases/$(database)/documents/outbox/$(eventId);
      }

      function canDispatch(ev) {
        return isSuperAdmin() || ev.get('createdBy', null) == request.auth.uid || isFinance(ev.orgId);
      }

      function isDeliveryOf(m, ev) {
        return ev.channel == 'firestore_mail' && ev.status == 'sending' && canDispatch(ev) &&
          m.keys().hasOnly(['to', 'message', 'from', 'replyTo', 'metadata']) &&
          m.to is list && m.to.size() == 1 && m.to[0] in ev.recipients &&
          !(m.to[0] in ev.get('deliveredTo', [])) &&
          mailId == (m.metadata.eventId + ':' + m.to[0]).replace('[^A-Za-z0-9_-]', '_') &&
          m.message.keys().hasOnly(['subject', 'html', 'text']) &&
          m.message.subject == ev.message.subject &&
          m.message.html == ev.message.html &&
          m.message.get('text', '') == ev.message.get('text', '') &&
          m.from == '"' + ev.meta.senderName + '" <' + ev.meta.senderEmail + '>' &&
          m.replyTo == ev.meta.replyTo;
      }

      allow get: if isAuthenticated() && (
        isMissing() || isSuperAdmin() || (
          resource.data.metadata.eventId is string &&
          exists(outboxPath(resource.data.metadata.eventId)) &&
          canDispatch(get(outboxPath(resource.data.metadata.eventId)).data)
        )
      );
      allow create: if isAuthenticated() &&
        request.resource.data.metadata.eventId is string &&
        request.resource.data.metadata.eventId.matches('[^/]+') &&
        exists(outboxPath(request.resource.data.metadata.eventId)) &&
        isDeliveryOf(request.resource.data, get(outboxPath(request.resource.data.metadata.eventId)).data);
      allow update, delete: if false;
    }

    // =========================================================================
    // 15b. LEGACY RESTORE MARKERS (src/domain/legacyRecovery.ts)
    //      One permanent marker per record restored from a browser's old local data,
    //      so a restored record that is later deleted on purpose never comes back.
    // =========================================================================
    match /legacyRestores/{markerId} {
      allow get: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.restoredBy == request.auth.uid &&
        (isSuperAdmin() || (request.resource.data.get('orgId', '') != '' && isOrgMember(request.resource.data.orgId)));
      allow update, delete: if false;
    }

    // =========================================================================
    // 16. SHARED SYSTEM SETTINGS (email notification settings)
    // =========================================================================
    match /system_settings/{settingId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && (
        settingId in ['email_notifications', 'notification_recipients'] && exists(profilePath()) &&
        get(profilePath()).data.get('active', true) != false && get(profilePath()).data.get('orgId', '') != ''
      ));
      allow write: if isSuperAdmin();
    }
  }
}
