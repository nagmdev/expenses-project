rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS & RBAC ENFORCEMENT
    // =========================================================================
    // Budgets (firestore limits): 1000 expressions per evaluated write, 10 document
    // reads (get/exists/getAfter/existsAfter) per write and 20 per transaction. The
    // financial rules below therefore (1) dispatch on the transition / changed keys
    // first, (2) read each document once (get() == null instead of exists() + get()),
    // and (3) test the caller's role LAST, with the super-admin check after it.
    function isAuthenticated() {
      return request.auth != null;
    }

    // Anyone can create an email/password account for an address they do not own
    // (the provider is enabled for admin provisioning), so an email only proves
    // identity once Firebase has verified it. Google sign-in emails are verified.
    function hasVerifiedEmail() {
      return request.auth.token.get('email_verified', false) == true &&
        request.auth.token.get('email', null) is string &&
        request.auth.token.email != '';
    }

    // Only call after hasVerifiedEmail().
    function verifiedEmail() {
      return request.auth.token.email.lower();
    }

    // The ONLY built-in platform owner. Keep identical to DEFAULT_SUPER_ADMINS in
    // src/context/AppContext.tsx. Other super admins exist only as super_admins/{uid}
    // or super_admins/{verified email} records created by a super admin.
    function builtInSuperAdmins() {
      return ['mahmoud@tieapps.com'];
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/super_admins/$(request.auth.uid)) ||
        (hasVerifiedEmail() && (
          exists(/databases/$(database)/documents/super_admins/$(verifiedEmail())) ||
          verifiedEmail() in builtInSuperAdmins()
        ))
      );
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function ownMemberPath(orgId) {
      return /databases/$(database)/documents/members/$(request.auth.uid + '_' + orgId);
    }

    // d: a users/{uid} or members/{uid}_{org} document as returned by get() (null when
    // missing). It grants orgId when it names that org and is not suspended. A detached
    // profile (orgId '') grants no company, whatever role it still carries.
    function grantsOrg(d, orgId) {
      return d != null && orgId is string && orgId != '' && d.data.get('orgId', null) == orgId && d.data.get('active', true) != false;
    }

    // users/{uid} holds the caller's primary org and their role in THAT org only.
    // A suspended profile (active: false) grants nothing.
    function inOrgViaProfile(orgId) {
      return grantsOrg(get(profilePath()), orgId);
    }

    // members/{uid}_{orgId} holds the caller's role in orgId. The orgId field is
    // checked as well as the document id, so an id that names another org grants nothing.
    // A suspended membership (active: false) grants nothing.
    function inOrgViaMember(orgId) {
      return grantsOrg(get(ownMemberPath(orgId)), orgId);
    }

    // A role held in one org never applies to another org. One read per document.
    function hasOrgRole(orgId, roles) {
      return isAuthenticated() && (
        roleVia(get(profilePath()), orgId, roles) || roleVia(get(ownMemberPath(orgId)), orgId, roles)
      );
    }

    function roleVia(d, orgId, roles) {
      return grantsOrg(d, orgId) && d.data.get('role', null) in roles;
    }

    // Membership / role first, the super-admin lookups only when that fails.
    function isOrgMember(orgId) {
      return (isAuthenticated() && (inOrgViaProfile(orgId) || inOrgViaMember(orgId))) || isSuperAdmin();
    }

    function isOrgAdmin(orgId) {
      return hasOrgRole(orgId, ['org_admin']) || isSuperAdmin();
    }

    // Data-entry staff maintain their company's directory (providers, departments).
    function isDataEntry(orgId) {
      return hasOrgRole(orgId, ['data_entry']);
    }

    function isFinance(orgId) {
      return hasOrgRole(orgId, ['finance', 'org_admin']) || isSuperAdmin();
    }

    // A record another company shares with the caller's company (a service's orgIds, set by
    // the platform owner only). The caller's company is the one of their active profile, so a
    // query where('orgIds', 'array-contains', <that company>) can be proven against this.
    function inSharedOrgViaProfile(orgIds) {
      return isAuthenticated() && get(profilePath()) != null &&
        get(profilePath()).data.get('active', true) != false &&
        get(profilePath()).data.get('orgId', '') is string &&
        get(profilePath()).data.get('orgId', '') != '' &&
        get(profilePath()).data.get('orgId', '') in orgIds;
    }

    function hasSharedOrgRole(orgIds, roles) {
      return inSharedOrgViaProfile(orgIds) && get(profilePath()).data.get('role', null) in roles;
    }

    // Payout details (bank, IBAN, InstaPay, wallet) belong in users/{uid} only: members/*
    // can be listed by every member of the company.
    function payoutKeys() {
      return ['instapay', 'wallet', 'walletProvider', 'bankName', 'iban'];
    }

    // None may be added to or changed in a membership (removing ones an older version copied is fine).
    function noPayoutAddedOrChanged() {
      return !request.resource.data.diff(resource.data).addedKeys().hasAny(payoutKeys()) &&
        !request.resource.data.diff(resource.data).changedKeys().hasAny(payoutKeys());
    }

    // The fields that decide what a membership grants, and to whom (grantsMembership trusts them).
    function grantFields() {
      return ['role', 'orgId', 'userId', 'userEmail', 'active'];
    }

    // The platform owner's membership, and the caller's own: an org admin can neither delete
    // them nor change what they grant. Only a super admin can (src/domain/directory.ts ->
    // membershipProtection).
    function isProtectedMembership(m) {
      return m.get('userId', null) == request.auth.uid || (
        m.get('userEmail', null) is string && (
          m.userEmail.lower() in builtInSuperAdmins() ||
          (hasVerifiedEmail() && m.userEmail.lower() == verifiedEmail())
        )
      );
    }

    // members/{memberId} records that an admin of orgId gave the caller `role` there:
    // same org and role, not suspended, and addressed either to the caller's UID or to
    // the caller's verified email (members invited by email before their first
    // sign-in). Member documents are written only by admins of their org (see
    // /members), so this cannot be forged. The id is taken from the caller, which is
    // why legacy placeholder ids (pending-<base64>, temp_…, usr-…) keep working.
    function grantsMembership(memberId, orgId, role) {
      return memberId is string && memberId.matches('[^/]+') &&
        orgId is string && orgId != '' &&
        role in ['org_admin', 'finance', 'data_entry', 'employee'] &&
        exists(/databases/$(database)/documents/members/$(memberId)) &&
        isGrantFor(get(/databases/$(database)/documents/members/$(memberId)).data, orgId, role);
    }

    function isGrantFor(member, orgId, role) {
      return member.get('orgId', null) == orgId &&
        member.get('role', null) == role &&
        member.get('active', true) != false && (
          member.get('userId', null) == request.auth.uid ||
          (hasVerifiedEmail() && member.get('userEmail', null) == verifiedEmail())
        );
    }

    function sameField(after, before, field, fallback) {
      return after.get(field, fallback) == before.get(field, fallback);
    }

    // A user may write their own users/{uid} profile (name, phone, payout details…),
    // but the fields that grant access may only take values an admin granted:
    //  - role / orgId / active: unchanged; or no org at all (a bare profile grants
    //    nothing); or exactly the membership named in memberId (self-link on first
    //    sign-in, see forceRefreshUserState).
    //  - email: unchanged, or the caller's own verified address. Admin tooling looks
    //    profiles up by email, so nobody may claim someone else's address.
    //  - verifiedEmail: unchanged, or the caller's own verified address. It is the account's
    //    proof of its address (see /users): nobody else may write it.
    //  - memberId: a grant field too. It names the membership the profile carries: the app syncs
    //    that membership's role / company onto every profile naming it (directory.ts →
    //    updateMemberRecord) and re-points a placeholder's userId to it (members →
    //    userIdChangeOk). It changes only with the self-link (granted membership), or is
    //    cleared on a profile without a company.
    // `before` is {} on create.
    function isOwnProfileWrite(userId, before) {
      let after = request.resource.data;
      return isAuthenticated() && request.auth.uid == userId && (
        sameField(after, before, 'email', null) ||
        (hasVerifiedEmail() && after.get('email', null) == verifiedEmail())
      ) && (
        sameField(after, before, 'verifiedEmail', null) ||
        (hasVerifiedEmail() && after.get('verifiedEmail', null) == verifiedEmail())
      ) && (
        (sameField(after, before, 'role', null) && sameField(after, before, 'orgId', null) && sameField(after, before, 'active', true) &&
          sameField(after, before, 'memberId', null)) ||
        (after.get('orgId', null) in [null, ''] && after.get('role', 'employee') == 'employee' &&
          (sameField(after, before, 'memberId', null) || after.get('memberId', null) == null)) ||
        (after.get('active', true) == true && grantsMembership(after.get('memberId', null), after.get('orgId', null), after.get('role', null)))
      );
    }

    // Idempotent creates read the target document inside a transaction first
    // ("does this operation already exist?"). Reading a document that does not
    // exist reveals nothing, so a single-document GET of a missing doc is allowed.
    function isMissing() {
      return resource == null;
    }

    // Company staff may edit their company's documents but never move one into another
    // company (that would inject data into, or steal it from, a tenant they don't run).
    function orgUnchanged() {
      return request.resource.data.get('orgId', null) == resource.data.get('orgId', null);
    }

    // -------------------------------------------------------------------------
    // Money helpers. Amounts are decimal doubles rounded to cents by the domain
    // (toMoney = Math.round(n * 100) / 100), so sums are compared with a tolerance,
    // and as DELTAS of one operation (never as an equation over historical totals,
    // which older app versions left inconsistent). 0.0051 also absorbs a legacy value
    // that was never rounded (at most half a cent away from its rounded form).
    // -------------------------------------------------------------------------
    function near(a, b) {
      return math.abs(a - b) < 0.0051;
    }

    // A value the domain wrote (toMoney: whole cents). Every new balance / remainder / amount is
    // one: then a delta that is near() its line or invoice is exactly that amount, and no
    // operation can move a total by a fraction of a cent more or less than it explains.
    // (1e-4 of a cent absorbs the binary representation of large amounts.)
    function isCents(v) {
      return v is number && math.abs(v * 100 - math.round(v * 100)) < 0.0001;
    }

    // A numeric field, 0 when missing, null or not a number (legacy documents).
    function num(m, f) {
      return m.get(f, 0) is number ? m.get(f, 0) : 0;
    }

    // An account's balance as the domain reads it (currentBalance ?? balance ?? 0).
    function balanceOf(m) {
      return m.get('currentBalance', null) is number ? m.currentBalance : num(m, 'balance');
    }

    function listOf(m, f) {
      return m.get(f, null) is list ? m.get(f, null) : [];
    }

    // History arrays (timeline, comments) only ever grow at the end.
    function appended(b, a, f) {
      let o = listOf(b, f);
      let n = listOf(a, f);
      return n.size() >= o.size() && (o.size() == 0 || n[0:o.size()] == o);
    }

    function ledgerPath(id) {
      return /databases/$(database)/documents/accountTransactions/$(id);
    }

    function accountPath(id) {
      return /databases/$(database)/documents/paymentAccounts/$(id);
    }

    // services.spentAmount / providers.totalPaid: raised only by the request disbursed in
    // the SAME transaction (named in lastDisbursedRequestId), by exactly its amount, once
    // ('disbursed' is terminal), and only for a record of the request's company (or a
    // service shared with it). No role check: the request's own update rule requires the
    // finance / org admin role of its company in the same commit.
    function paidByRequest(docId, linkField, counter, sharedOrgIds) {
      let rid = request.resource.data.get('lastDisbursedRequestId', '');
      return rid is string && rid != '' &&
        paidByRequestDoc(get(/databases/$(database)/documents/requests/$(rid)),
          getAfter(/databases/$(database)/documents/requests/$(rid)), docId, linkField, counter, sharedOrgIds);
    }

    function paidByRequestDoc(before, after, docId, linkField, counter, sharedOrgIds) {
      return before != null && after != null &&
        before.data.get('status', '') != 'disbursed' && after.data.get('status', '') == 'disbursed' &&
        before.data.get('requestType', 'expense') != 'income' &&
        before.data.get(linkField, '') == docId &&
        (before.data.get('orgId', '') == resource.data.get('orgId', '') || before.data.get('orgId', '') in sharedOrgIds) &&
        before.data.get('amount', null) is number &&
        // The domain adds the cent-rounded amount (toMoney) to a counter that may itself be a
        // legacy unrounded value: compare with the rounded amount (one rounding per side).
        near(num(request.resource.data, counter) - num(resource.data, counter), math.round(before.data.amount * 100) / 100.0);
    }

    // A record with money already through it (a used budget, a paid provider, an account
    // with a balance) is never deleted, only deactivated (src/domain/directory.ts →
    // hasFinancialHistory, treasury.ts → assertPaymentAccountDeletable). Missing / null is
    // zero (legacy); any other non-number (e.g. the string '250000', which the app reads
    // with Number()) is NOT zero: refused on create, kept on delete (the owner fixes it).
    function counterIsZero(m, f) {
      return m.get(f, 0) == null || (m.get(f, 0) is number && math.abs(m.get(f, 0)) < 0.005);
    }

    // The holder of a custody may file invoices against it: by UID, or by VERIFIED email
    // (custodies issued to a member invited by email), and only while still an active
    // member of its company. Never by name (members can rename themselves).
    function isCustodyHolder(c) {
      return (c.get('employeeId', '') == request.auth.uid ||
          (hasVerifiedEmail() && c.get('employeeEmail', '') == verifiedEmail())) &&
        (inOrgViaProfile(c.orgId) || inOrgViaMember(c.orgId));
    }

    // -------------------------------------------------------------------------
    // Uniqueness keys (see 14. uniqueKeys): the value a key holds, exactly as the domain
    // computes it (src/domain/common.ts → normalizeKeyValue): keep the two in step.
    // -------------------------------------------------------------------------
    // Only A-Z are lower-cased (lower() only on an ASCII-only value, see keyBase: whether it maps
    // non-ASCII capitals, and how, need not match JavaScript's toLowerCase).
    function asciiLower(v) {
      return v.replace('A', 'a').replace('B', 'b').replace('C', 'c').replace('D', 'd').replace('E', 'e')
        .replace('F', 'f').replace('G', 'g').replace('H', 'h').replace('I', 'i').replace('J', 'j')
        .replace('K', 'k').replace('L', 'l').replace('M', 'm').replace('N', 'n').replace('O', 'o')
        .replace('P', 'p').replace('Q', 'q').replace('R', 'r').replace('S', 's').replace('T', 't')
        .replace('U', 'u').replace('V', 'v').replace('W', 'w').replace('X', 'x').replace('Y', 'y')
        .replace('Z', 'z');
    }
    // Arabic-Indic and extended (Persian) digits read as the ASCII digit.
    function foldDigits(v) {
      return v.replace('[\\x{0660}\\x{06F0}]', '0').replace('[\\x{0661}\\x{06F1}]', '1').replace('[\\x{0662}\\x{06F2}]', '2')
        .replace('[\\x{0663}\\x{06F3}]', '3').replace('[\\x{0664}\\x{06F4}]', '4').replace('[\\x{0665}\\x{06F5}]', '5')
        .replace('[\\x{0666}\\x{06F6}]', '6').replace('[\\x{0667}\\x{06F7}]', '7').replace('[\\x{0668}\\x{06F8}]', '8')
        .replace('[\\x{0669}\\x{06F9}]', '9');
    }
    // Dropped from every value: JavaScript's \s (listed: RE2's \s is ASCII only, \p{Z} differs
    // from it), invisible format characters (soft hyphen, zero-width, direction marks, word
    // joiner), Arabic tatweel and harakat. Keep KEY_INVISIBLE identical.
    // (Each step only when the value has something to change: two matches() instead of 36 replace() calls.)
    function keyBase(v) {
      // (an ASCII-only value: lower() maps exactly A-Z there)
      let lowered = !v.matches('(?s).*[A-Z].*') ? v : v.matches('[\\x{0000}-\\x{007F}]*') ? v.lower() : asciiLower(v);
      let digits = lowered.matches('(?s).*[\\x{0660}-\\x{0669}\\x{06F0}-\\x{06F9}].*') ? foldDigits(lowered) : lowered;
      return digits.replace(
        '[\\t\\n\\x{000B}\\f\\r \\x{00A0}\\x{00AD}\\x{034F}\\x{061C}\\x{0640}\\x{064B}-\\x{065F}\\x{0670}\\x{1680}\\x{180E}\\x{2000}-\\x{200F}\\x{2028}\\x{2029}\\x{202F}\\x{205F}\\x{2060}\\x{3000}\\x{FEFF}]+', '');
    }
    // '-', '_' and '.' are dropped too, except where they tell two values apart: an email
    // (ahmed.ali@ / ahmedali@ are two people), an account identifier that is an address
    // (InstaPay ali.m@instapay). Keep keepsSeparators identical.
    function keepsSeparators(scope, v) {
      return scope == 'member_email' || (scope == 'account_identifier' && v.matches('(?s).*@.*'));
    }
    function keyNorm(v, scope) {
      return !(v is string) ? ''
        : keepsSeparators(scope, v) ? keyBase(v)
        : keyBase(v).replace('[\\-_.]+', '');
    }
    // The value as app versions before 2026-10 computed it (normalizeKeyValueV1): keys they
    // claim stay valid while their tabs are open.
    function keyNormV1(v) {
      return v is string
        ? asciiLower(v).replace('[\\t\\n\\x{000B}\\f\\r \\x{00A0}\\x{1680}\\x{2000}-\\x{200A}\\x{2028}\\x{2029}\\x{202F}\\x{205F}\\x{3000}\\x{FEFF}\\-_.]+', '')
        : '';
    }
    // encodeKeyPart (src/utils/ids.ts): base64url of the UTF-8 bytes, without padding.
    function keyPart(v) {
      return v.toUtf8().toBase64().replace('\\+', '-').replace('/', '_').replace('=+$', '');
    }
    // A record whose unique value changes (key field `field` of uniqueness scope `scope`) gives
    // up the key of its old value in the same commit when it owns it (domain: releaseUniqueKey).
    // Otherwise the key would keep naming a record that no longer holds its value, and nobody
    // could add or take that value again. Only evaluated when the field changes.
    function keyLeftWithRecord(scope, field, docId) {
      let v = keyNorm(resource.data.get(field, ''), scope);
      return v == '' || keyNorm(request.resource.data.get(field, ''), scope) == v ||
        oldKeyNotOwned(/databases/$(database)/documents/uniqueKeys/$(scope + '__' + resource.data.get('orgId', '') + '__' + keyPart(v)), docId);
    }
    function oldKeyNotOwned(keyPath, docId) {
      return !existsAfter(keyPath) || getAfter(keyPath).data.get('entityId', '') != docId;
    }

    // Default deny for unhandled collections
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // 1. SUPER ADMINS (System Management)
    // =========================================================================
    match /super_admins/{adminId} {
      // The list (with each admin's contact and payout details) is for super admins
      // only; anyone may read the record about themselves.
      allow get: if isAuthenticated() && (
        isSuperAdmin() ||
        adminId == request.auth.uid ||
        (hasVerifiedEmail() && adminId == verifiedEmail())
      );
      allow list: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 2. USERS (Profiles & Security Metadata)
    // =========================================================================
    match /users/{userId} {
      allow get: if isAuthenticated() && (isMissing() || request.auth.uid == userId || isSuperAdmin() || (resource.data.orgId != null && isOrgAdmin(resource.data.orgId)));
      allow list: if isAuthenticated() && (isSuperAdmin() || (resource.data.orgId != null && isOrgAdmin(resource.data.orgId)));
      // users/{uid}.verifiedEmail is the account's own proof of its address, written only by
      // that account from its verified token (isOwnProfileWrite). The app re-uses a UID for an
      // email in another company only on that proof (directory.ts → verifiedLoginUidOf): a
      // membership's (userId, userEmail) pair is only what some company's admin wrote.
      // Self-writes never grant a role or org the caller was not given (isOwnProfileWrite).
      // An org admin's OWN profile is a self-write like anyone else's (isOwnProfileWrite): the
      // admin branch would let it re-point its memberId or keep a role after its removal.
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        isOwnProfileWrite(userId, {}) ||
        (userId != request.auth.uid && isOrgAdmin(request.resource.data.orgId) && request.resource.data.role != 'super_admin' &&
          !request.resource.data.keys().hasAny(['verifiedEmail']))
      );
      // Org admins manage profiles in their org, and may detach one from it (member
      // removed: org cleared, role reset), but never move a profile to another org.
      allow update: if isSuperAdmin() || (
        userId != request.auth.uid &&
        isOrgAdmin(resource.data.orgId) &&
        request.resource.data.role != 'super_admin' &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verifiedEmail']) && (
          request.resource.data.orgId == resource.data.orgId ||
          (request.resource.data.get('orgId', null) in [null, ''] && request.resource.data.get('role', 'employee') == 'employee')
        )
      ) || isOwnProfileWrite(userId, resource.data);
      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 3. ORGANIZATIONS (Tenant Isolation)
    // =========================================================================
    match /organizations/{orgId} {
      allow get: if isAuthenticated() && (isMissing() || isSuperAdmin() || isOrgMember(orgId));
      allow list: if isAuthenticated() && (isSuperAdmin() || isOrgMember(orgId));
      allow create: if isSuperAdmin();
      // An org admin keeps the recipient list (membership changes) and the descriptive
      // fields; the identity (id, code), the base currency and the archive state are the
      // platform owner's. A missing field is never an error: diff() compares presence too.
      allow update: if (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['notificationRecipients', 'updatedAt', 'name', 'budget', 'description', 'logo']) &&
        hasOrgRole(orgId, ['org_admin'])
      ) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 4. MEMBERS (Company Users & RBAC)
    // =========================================================================
    match /members/{memberId} {
      // An invitation addressed to an email is the invitee's only once Firebase verified that
      // email (anyone can register an unverified account for any address; isGrantFor too).
      function isInviteeOf(m) {
        return hasVerifiedEmail() &&
          (m.get('userEmail', '') == request.auth.token.email || m.get('userEmail', '') == verifiedEmail());
      }
      allow get: if isAuthenticated() && (
        isMissing() ||
        isSuperAdmin() ||
        resource.data.userId == request.auth.uid ||
        isInviteeOf(resource.data) ||
        isOrgMember(resource.data.orgId)
      );
      allow list: if isAuthenticated() && (
        isSuperAdmin() ||
        resource.data.userId == request.auth.uid ||
        isInviteeOf(resource.data) ||
        isOrgMember(resource.data.orgId)
      );
      // The id is always <userId>_<orgId> (the rules look memberships up by that id).
      allow create: if isSuperAdmin() || (isOrgAdmin(request.resource.data.orgId) &&
        request.resource.data.role != 'super_admin' &&
        memberId == request.resource.data.userId + '_' + request.resource.data.orgId &&
        !request.resource.data.keys().hasAny(payoutKeys()));
      // Who a membership belongs to changes only from a placeholder (a member invited by
      // email who never had a login: pending-<email>, temp_…, usr-…) to the account whose own
      // profile links to this membership in the same commit (directory.ts → updateMemberRecord).
      // A membership of a real login is never re-pointed to another one.
      function userIdChangeOk() {
        let uid = request.resource.data.get('userId', '');
        return !(resource.data.get('userId', '') is string && resource.data.get('userId', '').matches('[A-Za-z0-9]{20,40}')) &&
          uid is string && uid.matches('[A-Za-z0-9]{20,40}') &&
          getAfter(/databases/$(database)/documents/users/$(uid)) != null &&
          getAfter(/databases/$(database)/documents/users/$(uid)).data.get('memberId', null) == memberId;
      }
      allow update: if isSuperAdmin() || (
        isOrgAdmin(resource.data.orgId) &&
        request.resource.data.role != 'super_admin' &&
        request.resource.data.orgId == resource.data.orgId &&
        noPayoutAddedOrChanged() &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId']) || userIdChangeOk()) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['userEmail']) ||
          keyLeftWithRecord('member_email', 'userEmail', memberId)) &&
        // The owner's and the admin's own membership: name / contact only, never role or status.
        (!isProtectedMembership(resource.data) ||
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(grantFields()))
      ) || (
        // Self-service edits of contact details only. Who the membership belongs to
        // (userId, userEmail) and what it grants (role, orgId, active) are admin-only:
        // grantsMembership() trusts these fields. Payout details go to users/{uid}.
        isAuthenticated() && resource.data.userId == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(grantFields()) &&
        noPayoutAddedOrChanged()
      );
      allow delete: if isSuperAdmin() || (isOrgAdmin(resource.data.orgId) && !isProtectedMembership(resource.data));
    }

    // =========================================================================
    // 5. SERVICES & CATEGORIES
    // =========================================================================
    match /services/{serviceId} {
      // Sharing a service with other companies (orgIds) is the platform owner's call: company
      // staff name no company but their own, and keep an existing list as it is.
      function sharingOwnOnly() {
        return request.resource.data.get('orgIds', []).size() == 0 ||
          request.resource.data.get('orgIds', []) == [request.resource.data.orgId];
      }
      function sharingUnchangedOrOwn() {
        return request.resource.data.get('orgIds', null) == resource.data.get('orgIds', null) || sharingOwnOnly();
      }
      function serviceUpdateOk() {
        let keys = request.resource.data.diff(resource.data).affectedKeys();
        return keys.hasAny(['spentAmount', 'lastDisbursedRequestId'])
          // Paying a request adds its amount (requests → disburse, same transaction).
          ? (keys.hasOnly(['spentAmount', 'updatedAt', 'lastDisbursedRequestId']) &&
             paidByRequest(serviceId, 'serviceCategoryId', 'spentAmount', resource.data.get('orgIds', [])))
          // Profile edit / deactivation by the owning company: spending untouched.
          : (!keys.hasAny(['orgId']) && sharingUnchangedOrOwn() &&
             (!keys.hasAny(['code']) || keyLeftWithRecord('service_code', 'code', serviceId)) &&
             hasOrgRole(resource.data.orgId, ['finance', 'org_admin']));
      }

      // A single read (e.g. the disbursement's tx.get of the request's service) by a member of
      // a sharing company whose membership there is a members/{uid}_{org} document (profile in
      // another company). Bounded: the first six companies of the list, one read each.
      function sharedViaMember(ids) {
        return (ids.size() > 0 && inOrgViaMember(ids[0])) || (ids.size() > 1 && inOrgViaMember(ids[1])) ||
          (ids.size() > 2 && inOrgViaMember(ids[2])) || (ids.size() > 3 && inOrgViaMember(ids[3])) ||
          (ids.size() > 4 && inOrgViaMember(ids[4])) || (ids.size() > 5 && inOrgViaMember(ids[5]));
      }

      // Readable in its own company and in every company it is shared with (list queries:
      // array-contains the caller's profile company). At most 10 reads: the profile, the own
      // company's membership, the two super-admin lookups, then six sharing companies.
      allow get: if isAuthenticated() && (isMissing() ||
        inOrgViaProfile(resource.data.orgId) || inOrgViaMember(resource.data.orgId) ||
        inSharedOrgViaProfile(listOf(resource.data, 'orgIds')) || isSuperAdmin() ||
        sharedViaMember(listOf(resource.data, 'orgIds')));
      allow list: if isAuthenticated() && (isSuperAdmin() || isOrgMember(resource.data.orgId) ||
        inSharedOrgViaProfile(resource.data.get('orgIds', [])));
      allow create: if (sharingOwnOnly() && counterIsZero(request.resource.data, 'spentAmount') &&
        hasOrgRole(request.resource.data.orgId, ['org_admin'])) || isSuperAdmin();
      allow update: if serviceUpdateOk() || isSuperAdmin();
      allow delete: if (counterIsZero(resource.data, 'spentAmount') && hasOrgRole(resource.data.orgId, ['org_admin'])) || isSuperAdmin();
    }

    // =========================================================================
    // 6. PROVIDERS & VENDORS
    // =========================================================================
    match /providers/{providerId} {
      function providerUpdateOk() {
        let keys = request.resource.data.diff(resource.data).affectedKeys();
        return keys.hasAny(['totalPaid', 'lastDisbursedRequestId'])
          ? (keys.hasOnly(['totalPaid', 'updatedAt', 'lastDisbursedRequestId']) &&
             paidByRequest(providerId, 'providerId', 'totalPaid', []))
          : (!keys.hasAny(['orgId']) &&
             (!keys.hasAny(['name']) || keyLeftWithRecord('provider_name', 'name', providerId)) &&
             hasOrgRole(resource.data.orgId, ['finance', 'org_admin']));
      }

      allow get: if isAuthenticated() && (isMissing() || isSuperAdmin() || isOrgMember(resource.data.orgId));
      allow list: if isAuthenticated() && (isSuperAdmin() || isOrgMember(resource.data.orgId));
      // Org admins and data entry add providers to their own company, always with nothing paid yet.
      allow create: if (counterIsZero(request.resource.data, 'totalPaid') &&
        hasOrgRole(request.resource.data.orgId, ['org_admin', 'data_entry'])) || isSuperAdmin();
      allow update: if providerUpdateOk() || isSuperAdmin();
      allow delete: if (counterIsZero(resource.data, 'totalPaid') && hasOrgRole(resource.data.orgId, ['org_admin'])) || isSuperAdmin();
    }

    // =========================================================================
    // 7. DEPARTMENTS
    // =========================================================================
    match /departments/{deptId} {
      allow get: if isAuthenticated() && (isMissing() || isSuperAdmin() || isOrgMember(resource.data.orgId));
      allow list: if isAuthenticated() && (isSuperAdmin() || isOrgMember(resource.data.orgId));
      // (create previously evaluated resource.data on a missing doc → only super admins could create)
      allow create: if isSuperAdmin() || isOrgAdmin(request.resource.data.orgId) || isDataEntry(request.resource.data.orgId);
      allow update: if isSuperAdmin() || (orgUnchanged() &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['name']) ||
          keyLeftWithRecord('department_name', 'name', deptId)) &&
        isOrgAdmin(resource.data.orgId));
      allow delete: if isSuperAdmin() || isOrgAdmin(resource.data.orgId);
    }

    // =========================================================================
    // 8. EXPENSE REQUESTS (Strict State Machine)
    // =========================================================================
    match /requests/{requestId} {
      function canReadRequest() {
        return resource.data.requesterId == request.auth.uid ||
          resource.data.requesterEmail == request.auth.token.email ||
          hasOrgRole(resource.data.orgId, ['finance', 'org_admin']) ||
          isSuperAdmin();
      }
      function isRequester() {
        return resource.data.requesterId == request.auth.uid || resource.data.requesterEmail == request.auth.token.email;
      }

      // Fields no edit may touch (domain: PROTECTED_FIELDS); status / decision records
      // change only through their own transition below.
      function frozenOnEdit() {
        return ['id', 'requestNumber', 'status', 'orgId', 'requesterId', 'requesterName', 'requesterEmail',
          'comments', 'disbursement', 'rejectionReason', 'approvedBy', 'approvedAt', 'createdAt', 'operationKey'];
      }
      function invoiceOnly(keys) {
        return keys.hasOnly(['invoiceAttachment', 'attachments', 'timeline', 'updatedAt']);
      }

      // Same status: the requester's / org admin's edit of a request under review; finance
      // attaches the invoice; the org admin asks again (clarification_requested); an
      // approved request takes its invoice (finance / org admin) or an org-admin edit.
      function editOk(b, a, keys, from, oid) {
        return appended(b, a, 'timeline') && (
          (from in ['pending', 'clarification_requested'] && !keys.hasAny(frozenOnEdit()) &&
            (isRequester() || (invoiceOnly(keys) ? hasOrgRole(oid, ['org_admin', 'finance']) : hasOrgRole(oid, ['org_admin'])))) ||
          (from == 'clarification_requested' && keys.hasOnly(['comments', 'timeline', 'updatedAt']) &&
            appended(b, a, 'comments') && hasOrgRole(oid, ['org_admin'])) ||
          // (a money change on an approved request is not an edit: it goes back to pending,
          // see decisionOk; the approval covered the old amount / currency only)
          (from == 'approved' && !keys.hasAny(frozenOnEdit()) && !keys.hasAny(['amount', 'currency']) &&
            (invoiceOnly(keys) ? hasOrgRole(oid, ['org_admin', 'finance']) : hasOrgRole(oid, ['org_admin'])))
        );
      }

      function decisionOk(b, a, keys, from, to, oid) {
        return appended(b, a, 'timeline') && appended(b, a, 'comments') && (
          to == 'approved'
            ? (from in ['pending', 'clarification_requested'] &&
               keys.hasOnly(['status', 'approvedBy', 'approvedAt', 'comments', 'timeline', 'updatedAt']) &&
               a.get('approvedBy', '') == request.auth.uid &&
               hasOrgRole(oid, ['org_admin', 'finance']))
          : to == 'rejected'
            ? (from in ['pending', 'clarification_requested', 'approved'] &&
               keys.hasOnly(['status', 'rejectionReason', 'comments', 'timeline', 'updatedAt']) &&
               a.get('rejectionReason', '') is string && a.get('rejectionReason', '').size() > 0 &&
               hasOrgRole(oid, ['org_admin', 'finance']))
          : to == 'clarification_requested'
            ? (from == 'pending' &&
               keys.hasOnly(['status', 'comments', 'timeline', 'updatedAt']) &&
               hasOrgRole(oid, ['org_admin']))
          : to == 'pending'
            ? ((from == 'clarification_requested' &&
                keys.hasOnly(['status', 'comments', 'timeline', 'attachments', 'updatedAt']) && isRequester()) ||
               // org admin changed the money of an approved request: back to review
               (from == 'approved' && keys.hasAny(['amount', 'currency']) &&
                !keys.hasAny(['id', 'requestNumber', 'orgId', 'requesterId', 'requesterName', 'requesterEmail', 'comments',
                  'disbursement', 'rejectionReason', 'approvedBy', 'approvedAt', 'createdAt', 'operationKey']) &&
                hasOrgRole(oid, ['org_admin'])))
          : false
        );
      }

      // approved (or a pending income) -> disbursed, only together with its ledger line
      // tx-req-<id>, created in THIS transaction (!exists: a line booked earlier under that id,
      // e.g. the payment of a deleted request re-created under the same id, pays nothing) on
      // the account named in the disbursement, for the request's amount, in the request's
      // direction, as a 'request' line (a line explains one operation only: a custody line
      // never pays a request), and that line is the account's only movement in this
      // transaction (see accountTransactions / paymentAccounts).
      function disburseOk(b, a, keys, from, oid) {
        return (from == 'approved' || (from == 'pending' && b.get('requestType', 'expense') == 'income')) &&
          keys.hasOnly(['status', 'disbursement', 'timeline', 'updatedAt']) &&
          a.disbursement is map &&
          appended(b, a, 'timeline') &&
          !exists(ledgerPath('tx-req-' + requestId)) &&
          disbursementLineOk(getAfter(ledgerPath('tx-req-' + requestId)), a, b, oid) &&
          hasOrgRole(oid, ['org_admin', 'finance']);
      }
      function disbursementLineOk(line, a, b, oid) {
        return line != null &&
          line.data.get('referenceType', '') == 'request' &&
          line.data.get('referenceId', '') == requestId &&
          line.data.accountId == a.disbursement.get('accountId', '') &&
          line.data.type == (b.get('requestType', 'expense') == 'income' ? 'in' : 'out') &&
          b.get('amount', null) is number && near(line.data.amount, b.amount) &&
          disbursementAccountOk(getAfter(accountPath(line.data.accountId)), oid);
      }
      function disbursementAccountOk(acc, oid) {
        return acc != null && acc.data.get('orgId', '') == oid &&
          acc.data.get('lastLedgerId', '') == 'tx-req-' + requestId;
      }

      function requestUpdateOk() {
        let b = resource.data;
        let a = request.resource.data;
        let keys = a.diff(b).affectedKeys();
        let from = b.get('status', '');
        let to = a.get('status', '');
        return !keys.hasAny(['orgId']) && (
          to == from ? editOk(b, a, keys, from, b.orgId)
          : to == 'disbursed' ? disburseOk(b, a, keys, from, b.orgId)
          : decisionOk(b, a, keys, from, to, b.orgId)
        );
      }

      allow get: if isAuthenticated() && (isMissing() || canReadRequest());
      allow list: if isAuthenticated() && canReadRequest();

      // Create: strictly pending, authenticated member of the organization
      // The platform owner may also create a request in any state: restoring records the
      // old app version kept only in a browser (src/domain/legacyRecovery.ts).
      // A new request carries no decision records (approver, payment, rejection): those are
      // written only by their own transitions (domain: createExpenseRequest never sets them;
      // legacyRecovery.restoreBlock sends such a record to the owner).
      allow create: if isSuperAdmin() || (isAuthenticated() &&
        isOrgMember(request.resource.data.orgId) &&
        request.resource.data.status == 'pending' &&
        !request.resource.data.keys().hasAny(['disbursement', 'approvedBy', 'approvedAt', 'rejectionReason']) &&
        (request.resource.data.requesterId == request.auth.uid || isOrgAdmin(request.resource.data.orgId)));

      // Update: strictly guarded transitions. 'disbursed' is terminal (money has moved).
      allow update: if isAuthenticated() && (requestUpdateOk() || isSuperAdmin());

      // No domain flow deletes a request; a paid one is part of the books (owner only).
      allow delete: if isSuperAdmin() ||
        (resource.data.get('status', '') != 'disbursed' && isOrgAdmin(resource.data.orgId));
    }

    // =========================================================================
    // 8b. VISA REQUESTS (previously had no rule → every write was denied)
    // =========================================================================
    match /visaRequests/{visaId} {
      function canReadVisa() {
        return isSuperAdmin() || isFinance(resource.data.orgId) || resource.data.requesterId == request.auth.uid;
      }
      allow get: if isAuthenticated() && (isMissing() || canReadVisa());
      allow list: if isAuthenticated() && canReadVisa();
      // Super admin: any state (restoring visa requests that the old version never saved).
      allow create: if isSuperAdmin() ||
        (isAuthenticated() && isOrgMember(request.resource.data.orgId) && request.resource.data.status == 'pending' &&
          (request.resource.data.requesterId == request.auth.uid || isOrgAdmin(request.resource.data.orgId)));
      allow update: if isSuperAdmin() || (isFinance(resource.data.orgId) && orgUnchanged());
      allow delete: if isSuperAdmin() || isOrgAdmin(resource.data.orgId);
    }

    // =========================================================================
    // 9. PAYMENT ACCOUNTS & TREASURY VAULTS
    // =========================================================================
    // A balance changes ONLY together with the ledger line that explains it: the domain
    // writes lastLedgerId = the id of the account's one ledger line of the transaction
    // (createMovementBatch: one line per account per transaction). That line must be NEW
    // (created in this transaction), name this account, and move it by exactly its amount
    // (delta of currentBalance and of totalIn / totalOut), from the stored balance.
    match /paymentAccounts/{accountId} {
      // An account with a balance or any history (opening balance, money in or out) is part
      // of the books: it can be deactivated, never deleted (domain: assertPaymentAccountDeletable).
      // Zero to the cent like the domain (toMoney(v) === 0): legacy float noise such as
      // 0.1 + 0.2 - 0.3 is empty; a value stored as a string is not (fail closed).
      function hasNoHistory() {
        return counterIsZero(resource.data, 'currentBalance') &&
          counterIsZero(resource.data, 'balance') &&
          counterIsZero(resource.data, 'initialBalance') &&
          counterIsZero(resource.data, 'totalIn') &&
          counterIsZero(resource.data, 'totalOut');
      }

      // Org admin opens an account: an opening balance only with its opening line tx-open-<id>.
      function accountCreateOk() {
        let n = request.resource.data;
        let ob = n.get('initialBalance', 0);
        return ob is number && ob >= 0 &&
          n.get('currentBalance', 0) == ob && n.get('balance', 0) == ob &&
          n.get('totalIn', 0) == 0 && n.get('totalOut', 0) == 0 &&
          (ob == 0
            ? n.get('lastLedgerId', '') == ''
            : (n.get('lastLedgerId', '') == 'tx-open-' + accountId &&
               openingLineOk(getAfter(ledgerPath('tx-open-' + accountId)), ob))) &&
          (n.get('parentAccountId', '') == '' ||
            (n.get('type', '') == 'instapay' && n.parentAccountId != accountId &&
             getAfter(accountPath(n.parentAccountId)).data.get('orgId', '') == n.orgId)) &&
          hasOrgRole(n.orgId, ['org_admin']);
      }
      function openingLineOk(line, ob) {
        return line != null && line.data.accountId == accountId && line.data.type == 'in' &&
          line.data.get('referenceType', '') == 'initial' && near(line.data.amount, ob);
      }

      function accountUpdateOk() {
        let b = resource.data;
        let a = request.resource.data;
        let keys = a.diff(b).affectedKeys();
        return keys.hasAny(['currentBalance', 'balance', 'totalIn', 'totalOut', 'lastLedgerId'])
          ? balanceMoveOk(b, a, keys)
          : profileUpdateOk(b, a, keys);
      }

      function balanceMoveOk(b, a, keys) {
        let lid = a.get('lastLedgerId', '');
        return keys.hasOnly(['currentBalance', 'balance', 'totalIn', 'totalOut', 'updatedAt', 'lastLedgerId']) &&
          lid is string && lid != '' && lid != b.get('lastLedgerId', '') &&
          a.get('currentBalance', null) is number && a.get('balance', null) == a.currentBalance &&
          !exists(ledgerPath(lid)) &&
          movedByLine(getAfter(ledgerPath(lid)).data, b, a, lid) &&
          hasOrgRole(b.orgId, ['finance', 'org_admin']);
      }
      function movedByLine(l, b, a, lid) {
        return lineMovesAccount(l, b, a) && parentMirrored(b, lid, l);
      }

      // l: the line (a missing line makes .data an error, i.e. a refusal). Every line moves
      // at least a cent (the domain rounds amounts to cents: requirePositiveAmount / toMoney).
      function lineMovesAccount(l, b, a) {
        let before = balanceOf(b);
        let signed = l.type == 'in' ? l.amount : -l.amount;   // +amount for 'in', -amount for 'out'
        return l.accountId == accountId && l.type in ['in', 'out'] &&
          l.amount is number && l.amount >= 0.01 && isCents(l.amount) && isCents(a.currentBalance) &&
          near(l.get('balanceBefore', null), before) &&
          near(l.get('balanceAfter', null), a.currentBalance) &&
          near(a.currentBalance - before, signed) &&
          near(num(a, 'totalIn') - num(b, 'totalIn'), signed > 0 ? signed : 0) &&
          near(num(a, 'totalOut') - num(b, 'totalOut'), signed < 0 ? -signed : 0) &&
          // No movement creates or deepens an overdraft (an 'in' always reduces one);
          // the only exception is the bank correction of detachLegacyWallet.
          (signed > 0 || a.currentBalance >= 0 || detachCorrection(l));
      }

      // An InstaPay (or a not-yet-detached legacy wallet) linked to another account spends that
      // bank's money (domain: linkedParentIdOf / createMovementBatch): its movement is mirrored
      // on the bank in the same transaction, by the bank's own NEW line <lid>-parent of the
      // same direction and amount (the bank's rule checks that this line moves the bank). A
      // link to an account that no longer exists moves the channel alone, as the domain does.
      function parentMirrored(b, lid, l) {
        let p = b.get('parentAccountId', '');
        return !(b.get('type', '') in ['instapay', 'wallet']) || !(p is string) || p == '' || p == accountId ||
          mirrorOk(getAfter(accountPath(p)), lid + '-parent', l);
      }
      function mirrorOk(parent, plid, l) {
        return parent == null || (
          parent.data.get('lastLedgerId', '') == plid && !exists(ledgerPath(plid)) &&
          mirrorLineOk(getAfter(ledgerPath(plid)).data, l)
        );
      }
      // The bank's line mirrors THIS movement: same direction, amount and operation (the domain's
      // parentLedger is a copy of the channel's line). A mirror naming another operation would
      // let one bank movement also be the line of a second payment / custody issue / return.
      function mirrorLineOk(pl, l) {
        return pl.type == l.type && near(pl.amount, l.amount) &&
          pl.get('referenceType', '') == l.get('referenceType', '') &&
          pl.get('referenceId', '') == l.get('referenceId', '');
      }

      // detachLegacyWallet: the owner-confirmed correction booked on the bank, in the same
      // transaction that unlinks the wallet (which only an org admin may do, see linkOk). Only a
      // legacy WALLET: finance may unlink an InstaPay too, which must not open an overdraft.
      function detachCorrection(l) {
        return l.get('referenceType', '') == 'manual_adjustment' &&
          l.get('referenceId', '') is string && l.get('referenceId', '') != '' && l.referenceId != accountId &&
          get(accountPath(l.referenceId)).data.get('type', '') == 'wallet' &&
          get(accountPath(l.referenceId)).data.get('parentAccountId', '') == accountId &&
          getAfter(accountPath(l.referenceId)).data.get('parentAccountId', '') == '';
      }

      function profileUpdateOk(b, a, keys) {
        return keys.hasOnly(['name', 'accountIdentifier', 'type', 'bankName', 'currency', 'description', 'color', 'icon',
            'active', 'updatedAt', 'parentAccountId', 'parentAccountName']) &&
          // The currency of an account with history is fixed (a missing one reads as EGP).
          (!keys.hasAny(['currency']) || a.get('currency', 'EGP') == b.get('currency', 'EGP') || hasNoHistory()) &&
          (!keys.hasAny(['accountIdentifier']) || keyLeftWithRecord('account_identifier', 'accountIdentifier', accountId)) &&
          linkOk(b, a, keys) &&
          hasOrgRole(b.orgId, ['finance', 'org_admin']);
      }

      // Bank links (domain: updatePaymentAccount / detachLegacyWallet). Only an InstaPay is
      // (re)linked, to an account of its own company; an InstaPay may be unlinked; a
      // still-linked account keeps a mirroring type; a legacy linked wallet is only ever
      // detached (link removed, type kept), by the org admin.
      function linkOk(b, a, keys) {
        let p = a.get('parentAccountId', '');
        let bp = b.get('parentAccountId', '');
        let t = a.get('type', '');
        return !keys.hasAny(['parentAccountId', 'parentAccountName', 'type']) || (
          (b.get('type', '') == 'wallet' && bp != '' && bp != accountId)
            ? (p == '' && t == 'wallet' && hasOrgRole(b.orgId, ['org_admin']))
            : keys.hasAny(['parentAccountId'])
              ? (p == '' || p == accountId ||
                 (t == 'instapay' && getAfter(accountPath(p)).data.get('orgId', '') == b.orgId))
              // a link left on an account that never mirrored (cash / bank: linkedParentIdOf
              // ignores it) is inert, so such an account may be retyped
              : (p == '' || p == accountId || t in ['instapay', 'wallet'] || !(b.get('type', '') in ['instapay', 'wallet']))
        );
      }

      allow get: if isAuthenticated() && (isMissing() || isSuperAdmin() || isFinance(resource.data.orgId));
      allow list: if isAuthenticated() && (isSuperAdmin() || isFinance(resource.data.orgId));
      allow create: if accountCreateOk() || isSuperAdmin();
      allow update: if accountUpdateOk() || isSuperAdmin();
      allow delete: if hasNoHistory() && (hasOrgRole(resource.data.orgId, ['org_admin']) || isSuperAdmin());
    }

    // =========================================================================
    // 10. ACCOUNT TRANSACTIONS (Financial Ledger - Immutable)
    // =========================================================================
    // A line is created only as the movement of its account in the same transaction: the
    // account's lastLedgerId becomes this line (the account's rule then checks the amounts),
    // so a line can neither be invented nor applied twice, and an account takes one line
    // per transaction. No role check here: the account's own update / create rule has it.
    match /accountTransactions/{txId} {
      function ledgerCreateOk() {
        let n = request.resource.data;
        return n.get('id', txId) == txId &&
          n.get('actorId', '') == request.auth.uid &&                // attributed to the caller (domain: actor.id)
          n.get('accountId', '') is string && n.get('accountId', '') != '' &&
          lineIsAccountMove(get(accountPath(n.accountId)), getAfter(accountPath(n.accountId)), n);
      }
      function lineIsAccountMove(before, after, n) {
        return after != null &&
          after.data.get('lastLedgerId', '') == txId &&
          after.data.get('orgId', '') == n.get('orgId', '') &&
          (before == null
            ? txId == 'tx-open-' + n.accountId                       // opening line of a new account
            : before.data.get('lastLedgerId', '') != txId);
      }

      allow get: if isAuthenticated() && (isMissing() || isSuperAdmin() || isFinance(resource.data.orgId));
      allow list: if isAuthenticated() && (isSuperAdmin() || isFinance(resource.data.orgId));
      allow create: if ledgerCreateOk() || isSuperAdmin();
      allow update, delete: if isSuperAdmin(); // Financial ledgers cannot be modified by standard users
    }

    // =========================================================================
    // 11. PETTY CASH & CUSTODIES
    // =========================================================================
    // Every change of a custody's totals is one of the domain's operations, bound in the
    // same transaction to what explains it:
    //   issue      (create)   lastLedgerId -> 'custody' 'out' line of totalAmount
    //   settle               lastSettlementId -> the NEW settlement of exactly the debit
    //   replenish            lastLedgerId -> NEW 'custody' 'out' line of the top-up
    //   return               lastLedgerId -> NEW 'custody_return' 'in' line of the remainder
    // Nothing else about a custody is ever edited (holder, currency, source, number).
    match /custodies/{custodyId} {
      function canReadCustody() {
        return resource.data.employeeId == request.auth.uid ||
          (hasVerifiedEmail() && resource.data.employeeEmail == verifiedEmail()) ||
          hasOrgRole(resource.data.orgId, ['finance', 'org_admin']) ||
          isSuperAdmin();
      }

      // The issue line is created in this transaction (!exists), so it is the source account's
      // movement of this commit and explains nothing else.
      function issueOk() {
        let n = request.resource.data;
        let lid = n.get('lastLedgerId', '');
        return lid is string && lid != '' &&
          n.get('totalAmount', null) is number && n.totalAmount > 0 &&
          n.get('remainingAmount', null) == n.totalAmount &&
          n.get('settledAmount', 0) == 0 && n.get('returnedAmount', 0) == 0 &&
          n.get('status', '') == 'active' && n.get('lastSettlementId', '') == '' &&
          !exists(ledgerPath(lid)) &&
          issueLineOk(getAfter(ledgerPath(lid)), n) &&
          hasOrgRole(n.orgId, ['finance', 'org_admin']);
      }
      function issueLineOk(line, n) {
        return line != null &&
          line.data.get('referenceType', '') == 'custody' && line.data.get('referenceId', '') == custodyId &&
          line.data.type == 'out' && near(line.data.amount, n.totalAmount) &&
          line.data.accountId == n.get('sourceAccountId', '') && line.data.get('orgId', '') == n.orgId;
      }

      function custodyUpdateOk() {
        let b = resource.data;
        let a = request.resource.data;
        let keys = a.diff(b).affectedKeys();
        return keys.hasAny(['lastSettlementId'])
          ? settleOk(b, a, keys)
          : keys.hasAny(['returnedAmount'])
            ? returnOk(b, a, keys)
            : replenishOk(b, a, keys);
      }

      // Each delta is compared with the invoice / line amount (one cent rounding each), never
      // with another delta the domain rounded separately (legacy unrounded thirds). The
      // remainder strictly decreases, by an invoice of at least a cent.
      function settleOk(b, a, keys) {
        let sid = a.get('lastSettlementId', '');
        let d = num(a, 'settledAmount') - num(b, 'settledAmount');
        return keys.hasOnly(['remainingAmount', 'settledAmount', 'status', 'settledAt', 'updatedAt', 'lastSettlementId']) &&
          sid is string && sid != '' && d > 0 &&
          a.get('remainingAmount', null) is number && a.remainingAmount >= 0 &&
          isCents(a.remainingAmount) && isCents(num(a, 'settledAmount')) &&
          num(b, 'remainingAmount') - a.remainingAmount > 0 &&
          a.get('status', null) == (a.remainingAmount == 0 ? 'settled' : b.get('status', null)) &&
          !exists(/databases/$(database)/documents/custodySettlements/$(sid)) &&
          settlementOk(getAfter(/databases/$(database)/documents/custodySettlements/$(sid)), d, num(b, 'remainingAmount') - a.remainingAmount) &&
          (isCustodyHolder(b) || hasOrgRole(b.orgId, ['finance', 'org_admin']));
      }
      function settlementOk(s, d, r) {
        return s != null && s.data.get('custodyId', '') == custodyId &&
          s.data.get('amount', null) is number && s.data.amount >= 0.01 && isCents(s.data.amount) &&
          near(s.data.amount, d) && near(s.data.amount, r);
      }

      function replenishOk(b, a, keys) {
        let lid = a.get('lastLedgerId', '');
        let d = num(a, 'totalAmount') - num(b, 'totalAmount');
        return keys.hasOnly(['totalAmount', 'remainingAmount', 'status', 'notes', 'updatedAt', 'lastLedgerId']) &&
          lid is string && lid != '' && d > 0 &&
          a.get('totalAmount', null) is number && a.get('remainingAmount', null) is number &&
          a.get('status', '') == 'active' &&
          !exists(ledgerPath(lid)) &&
          custodyLineOk(getAfter(ledgerPath(lid)), 'custody', 'out', d, a.remainingAmount - num(b, 'remainingAmount'), b.orgId) &&
          hasOrgRole(b.orgId, ['finance', 'org_admin']);
      }

      function returnOk(b, a, keys) {
        let lid = a.get('lastLedgerId', '');
        let r = num(b, 'remainingAmount');
        return keys.hasOnly(['remainingAmount', 'returnedAmount', 'status', 'settledAt', 'returnedAt',
            'returnedToAccountId', 'returnedToAccountName', 'updatedAt', 'lastLedgerId']) &&
          lid is string && lid != '' && r > 0 &&
          a.get('remainingAmount', null) == 0 && a.get('status', '') == 'settled' &&
          !exists(ledgerPath(lid)) &&
          custodyLineOk(getAfter(ledgerPath(lid)), 'custody_return', 'in', r, num(a, 'returnedAmount') - num(b, 'returnedAmount'), b.orgId) &&
          getAfter(ledgerPath(lid)).data.accountId == a.get('returnedToAccountId', '') &&
          hasOrgRole(b.orgId, ['finance', 'org_admin']);
      }

      // The line of this custody's operation: its type, this custody, the custody's company
      // (never another company's account), and both changed totals equal to its amount.
      function custodyLineOk(line, refType, type, amount, amount2, orgId) {
        return line != null &&
          line.data.get('referenceType', '') == refType && line.data.get('referenceId', '') == custodyId &&
          line.data.get('orgId', '') == orgId &&
          line.data.type == type && near(line.data.amount, amount) && near(line.data.amount, amount2);
      }

      allow get: if isAuthenticated() && (isMissing() || canReadCustody());
      allow list: if isAuthenticated() && canReadCustody();
      allow create: if issueOk() || isSuperAdmin();
      allow update: if custodyUpdateOk() || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // No code has written this collection since 33560bb (custodies replaced it): read-only.
    match /pettyCashCustodies/{custodyId} {
      allow read: if isAuthenticated() && (
        resource.data.employeeId == request.auth.uid ||
        (hasVerifiedEmail() && resource.data.employeeEmail == verifiedEmail()) ||
        hasOrgRole(resource.data.orgId, ['finance', 'org_admin']) ||
        isSuperAdmin()
      );
      allow write: if isSuperAdmin();
    }

    match /custodySettlements/{settlementId} {
      function canReadSettlement() {
        return resource.data.employeeId == request.auth.uid ||
          (hasVerifiedEmail() && resource.data.employeeEmail == verifiedEmail()) ||
          hasOrgRole(resource.data.orgId, ['finance', 'org_admin']) ||
          isSuperAdmin();
      }
      // An invoice is filed only together with the custody debit it represents: the
      // custody's lastSettlementId becomes this settlement in the same transaction (the
      // custody's rule checks the amounts), by the custody's holder or its company's finance.
      function settlementCreateOk() {
        let n = request.resource.data;
        return n.get('custodyId', '') is string && n.get('custodyId', '') != '' &&
          n.get('amount', null) is number && n.amount > 0 &&
          debitedCustodyOk(getAfter(/databases/$(database)/documents/custodies/$(n.custodyId)), n);
      }
      function debitedCustodyOk(c, n) {
        return c != null &&
          c.data.get('lastSettlementId', '') == settlementId &&
          c.data.get('orgId', '') == n.get('orgId', '') &&
          n.get('employeeId', '') == c.data.get('employeeId', '') &&
          (isCustodyHolder(c.data) || hasOrgRole(n.orgId, ['finance', 'org_admin']));
      }

      allow get: if isAuthenticated() && (isMissing() || canReadSettlement());
      allow list: if isAuthenticated() && canReadSettlement();
      allow create: if isAuthenticated() && (settlementCreateOk() || isSuperAdmin());
      allow update, delete: if isSuperAdmin();
    }

    // =========================================================================
    // 12. AUDIT LOGS & EMAIL LOGS (Append-Only)
    // =========================================================================
    match /auditLogs/{logId} {
      allow get: if isAuthenticated() && (isMissing() || isSuperAdmin() || isOrgAdmin(resource.data.orgId));
      allow list: if isAuthenticated() && (isSuperAdmin() || isOrgAdmin(resource.data.orgId));
      // An entry can only be written in the caller's own name (no forged actors): its UID and
      // its sign-in email (the app writes actor.email = the Firebase user's email; actorName is
      // the member's self-editable display name and proves nothing). An entry outside any
      // company (platform settings, super admin changes) is the platform owner's.
      allow create: if isAuthenticated() && request.resource.data.actorId == request.auth.uid &&
        (request.auth.token.get('email', null) == null ||
          request.resource.data.get('actorEmail', request.auth.token.email) == request.auth.token.email) &&
        ((request.resource.data.get('orgId', '') != '' && isOrgMember(request.resource.data.orgId)) || isSuperAdmin());
      allow update, delete: if isSuperAdmin();
    }

    match /email_logs/{logId} {
      allow read, write: if isAuthenticated() && isSuperAdmin();
    }

    // =========================================================================
    // 13. ATOMIC SEQUENCES (request / custody / visa numbers)
    //     Can only ever move forward by exactly one → numbers are never reissued.
    // =========================================================================
    match /counters/{counterId} {
      function mayAdvance() {
        // finance / org admin of the caller's (active) profile company: a suspended or
        // detached profile's stale role grants nothing (grantsOrg checks active and orgId).
        return (counterId.matches('^(custodies|transfers)-[0-9]{4}$') && get(profilePath()) != null &&
            hasOrgRole(get(profilePath()).data.get('orgId', ''), ['finance', 'org_admin'])) ||
          (counterId.matches('^(requests|visa)-[0-9]{4}$') && get(profilePath()) != null &&
            get(profilePath()).data.get('active', true) != false && get(profilePath()).data.get('orgId', '') != '') ||
          isSuperAdmin();
      }
      allow get: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.value == 1 && mayAdvance();
      allow update: if isAuthenticated() && request.resource.data.value == resource.data.value + 1 && mayAdvance();
      allow delete: if false;
    }

    // =========================================================================
    // 14. UNIQUENESS REGISTRY (Firestore has no UNIQUE constraint)
    //     One document per unique value (account number, service code, member email…)
    // =========================================================================
    match /uniqueKeys/{keyId} {
      // The id is <scope>__<company id>__<value> (src/domain/common.ts → uniqueKeyDocId).
      function keyOrgId() {
        return keyId.split('__')[1];
      }
      function inKeyCompany() {
        return keyId.split('__').size() >= 2 && keyOrgId() != '-' && isOrgMember(keyOrgId());
      }
      // The record field a scope's key is claimed for (src/domain: normalizeKeyValue of it).
      function keyField(scope) {
        return scope == 'account_identifier' ? 'accountIdentifier'
          : scope == 'service_code' ? 'code'
          : scope == 'member_email' ? 'userEmail'
          : 'name';
      }
      function keyCollection(scope) {
        return scope == 'account_identifier' ? 'paymentAccounts'
          : scope == 'service_code' ? 'services'
          : scope == 'provider_name' ? 'providers'
          : scope == 'department_name' ? 'departments'
          : 'members';
      }
      // A key is claimed for the record it names (domain: claimUniqueKey always writes the
      // record in the same transaction): its id is <scope>__<company>__<encoded value>, and
      // that record, after the commit, is of the key's company and holds that value. So a
      // key can never be squatted for a value no record of the company holds; the record's
      // own rule decides who may write it.
      function claimedByRecord() {
        let k = request.resource.data;
        let scope = k.get('scope', '');
        let parts = keyId.split('__');
        return scope in ['account_identifier', 'service_code', 'provider_name', 'department_name', 'member_email'] &&
          parts.size() == 3 && parts[0] == scope &&
          k.get('value', null) is string && k.value != '' && parts[2] == keyPart(k.value) &&
          k.get('entityCollection', '') == keyCollection(scope) &&
          k.entityId != '' &&
          recordHoldsKey(getAfter(/databases/$(database)/documents/$(keyCollection(scope))/$(k.entityId)), keyField(scope), k);
      }
      // (keyNormV1: a key claimed by an app version before 2026-10, still open in a tab.)
      function recordHoldsKey(after, f, k) {
        return after != null && after.data.get('orgId', '') == k.orgId && (
          keyNorm(after.data.get(f, ''), k.get('scope', '')) == k.value || keyNormV1(after.data.get(f, '')) == k.value);
      }
      // The current normalization only (a take-over claims a current-format value).
      function recordHoldsKeyNow(d, f, k) {
        return d != null && d.data.get('orgId', '') == k.orgId && keyNorm(d.data.get(f, ''), k.get('scope', '')) == k.value;
      }
      // A record changes the value its key holds (account number, provider name, service
      // code, department name, member email): the old key is released in the same
      // transaction. Allowed when the record named by the key changes that field in this
      // very write and no longer holds the value (or moved to another company); the
      // record's own rule decides who may make that change.
      function releasedByChange() {
        let k = resource.data;
        let scope = k.get('scope', '');
        return scope in ['account_identifier', 'service_code', 'provider_name', 'department_name', 'member_email'] &&
          k.get('orgId', '-') != '-' &&
          k.get('entityCollection', '') == keyCollection(scope) &&
          k.get('entityId', '') is string && k.get('entityId', '') != '' &&
          valueLeftRecord(get(/databases/$(database)/documents/$(keyCollection(scope))/$(k.entityId)),
            getAfter(/databases/$(database)/documents/$(keyCollection(scope))/$(k.entityId)), keyField(scope), k);
      }
      function valueLeftRecord(before, after, f, k) {
        return before != null && after != null &&
          before.data.get(f, null) != after.data.get(f, null) &&
          (keyNorm(after.data.get(f, ''), k.get('scope', '')) != k.get('value', '') || after.data.get('orgId', '') != k.orgId);
      }
      // A key whose record no longer holds its value (released in this very commit, or left
      // stale: a record deleted or renamed without it by an older app version) is taken over by
      // the record that claims the value now (domain: readUniqueKey treats it as free and
      // claimUniqueKey overwrites it). The current record holds it before AND after: never.
      function takenOver() {
        let k = resource.data;
        let scope = k.get('scope', '');
        return request.resource.data.get('scope', '') == scope &&
          k.get('entityCollection', '') == keyCollection(scope) &&
          k.get('entityId', '') is string && k.get('entityId', '') != '' &&
          (k.entityId == request.resource.data.entityId
            // the record takes its own key back (it holds the value after: claimedByRecord): only one it did not hold
            ? !recordHoldsKeyNow(get(/databases/$(database)/documents/$(keyCollection(scope))/$(k.entityId)), keyField(scope), k)
            // another record: the one named now no longer holds the value after this commit
            : !recordHoldsKeyNow(getAfter(/databases/$(database)/documents/$(keyCollection(scope))/$(k.entityId)), keyField(scope), k));
      }

      // A key names a record of its company (e.g. a member's email and id). Readable by that
      // company's members only, whether it exists or not: an answer that differed between a
      // missing and an existing key would tell anyone which emails, providers or account
      // numbers another company has. Company-less keys (org codes) and keys in the old id
      // format (company id encoded) are read by the platform owner only.
      allow get: if isAuthenticated() && (isSuperAdmin() || inKeyCompany());
      allow create: if isAuthenticated() && request.resource.data.entityId is string && (
        (request.resource.data.orgId != '-' && request.resource.data.orgId == keyOrgId() &&
          claimedByRecord() && inKeyCompany()) ||
        isSuperAdmin()
      );
      allow update: if isAuthenticated() && request.resource.data.entityId is string &&
        request.resource.data.orgId != '-' && request.resource.data.orgId == keyOrgId() &&
        request.resource.data.orgId == resource.data.get('orgId', '-') &&
        claimedByRecord() && takenOver() && inKeyCompany();
      allow delete: if isAuthenticated() && (
        releasedByChange() ||
        (
          resource.data.orgId != '-' &&
          resource.data.entityCollection is string &&
          resource.data.entityId is string &&
          // existsAfter: the record and its key are removed in the same batch / transaction.
          !existsAfter(/databases/$(database)/documents/$(resource.data.entityCollection)/$(resource.data.entityId)) &&
          isOrgAdmin(resource.data.orgId)
        ) ||
        isSuperAdmin()
      );
    }

    // =========================================================================
    // 15. NOTIFICATION OUTBOX (email / webhook delivery with retries)
    // =========================================================================
    match /outbox/{eventId} {
      function canManageOutbox() {
        return isSuperAdmin() || resource.data.createdBy == request.auth.uid ||
          (resource.data.orgId != '' && isFinance(resource.data.orgId));
      }
      // eventId = <eventType>__<entityId>[__<operationKey>] (see outboxEventId), or
      // test_email__<key> for a settings-page test email.
      function idParts() {
        return eventId.split('__');
      }

      // Where an org's admin-facing notifications may go: its active org admins
      // (organizations/{orgId}.notificationRecipients, maintained with memberships) and
      // the platform super admins (system_settings/notification_recipients + built-ins).
      function adminRecipients(orgId) {
        return get(/databases/$(database)/documents/organizations/$(orgId)).data.get('notificationRecipients', [])
          .concat(builtInSuperAdmins())
          .concat(exists(/databases/$(database)/documents/system_settings/notification_recipients)
            ? get(/databases/$(database)/documents/system_settings/notification_recipients).data.get('emails', [])
            : []);
      }

      // The request as it will be after this write (created / updated in the same transaction).
      function requestAfter(e) {
        return getAfter(/databases/$(database)/documents/requests/$(e.entityId)).data;
      }

      function requesterEmailOf(req) {
        return req.get('requesterEmail', '').trim().lower();
      }

      function isRequesterOf(req) {
        return req.get('requesterId', null) == request.auth.uid ||
          (hasVerifiedEmail() && requesterEmailOf(req) == verifiedEmail());
      }

      // Each request event is bound to a request of the same org, raised by the party
      // the workflow allows, and addressed only to the people that event notifies.
      function isRequestEvent(e) {
        return e.entityType == 'request' && e.entityId is string &&
          idParts()[0] == e.eventType && idParts()[1] == e.entityId &&
          existsAfter(/databases/$(database)/documents/requests/$(e.entityId)) &&
          requestAfter(e).get('orgId', null) == e.orgId && (
            (e.eventType == 'new_request' && idParts().size() == 2 &&
              requestAfter(e).get('requesterId', null) == request.auth.uid &&
              e.recipients.hasOnly(adminRecipients(e.orgId))) ||
            (e.eventType == 'clarification_replied' && idParts().size() == 3 &&
              isRequesterOf(requestAfter(e)) &&
              e.recipients.hasOnly(adminRecipients(e.orgId))) ||
            (e.eventType in ['request_approved', 'request_rejected', 'clarification_requested'] && idParts().size() == 3 &&
              isFinance(e.orgId) &&
              e.recipients == [requesterEmailOf(requestAfter(e))]) ||
            (e.eventType == 'request_paid' && idParts().size() == 2 &&
              isFinance(e.orgId) &&
              e.recipients == [requesterEmailOf(requestAfter(e))])
          );
      }

      // The sender identity and the delivery channel are the platform's, never the event
      // creator's choice: as buildOutboxEvent (src/domain/outbox.ts) builds them from
      // system_settings/email_notifications over DEFAULT_EMAIL_SETTINGS — or from those
      // defaults alone (a tab whose settings listener has not caught up). A webhook goes only
      // to the configured URL. The message body is the app's template output and cannot be
      // checked here; its recipients are bound above. Defaults: DEFAULT_EMAIL_SETTINGS
      // (src/services/emailTemplates.ts), keep in step.
      function deliveryOk(e) {
        let s0 = get(/databases/$(database)/documents/system_settings/email_notifications);
        let s = s0 == null ? {} : s0.data;
        let m = e.meta;
        let url = s.get('webhookUrl', '');
        return m.get('senderName', '') in [s.get('senderName', ''), 'نظام مصروفي'] &&
          m.get('senderEmail', '') in [s.get('senderEmail', ''), 'awadhsaudi2030@gmail.com'] &&
          m.get('replyTo', '') in [s.get('replyToEmail', ''), s.get('senderEmail', ''), 'awadhsaudi2030@gmail.com'] &&
          (e.channel == 'webhook'
            ? (s.get('deliveryMethod', '') == 'webhook' && url != '' && m.get('webhookUrl', '') == url)
            : (e.channel in ['email_api', 'firestore_mail'] && m.get('webhookUrl', '') == ''));
      }

      // Settings-page test email: org admins, to their org's admin recipients or themselves.
      function isTestEvent(e) {
        return e.entityType == 'system' && e.entityId == 'test' &&
          idParts()[0] == 'test_email' && idParts().size() == 2 &&
          isOrgAdmin(e.orgId) &&
          e.recipients.hasOnly(adminRecipients(e.orgId).concat(hasVerifiedEmail() ? [verifiedEmail()] : []));
      }

      allow get: if isAuthenticated() && (isMissing() || canManageOutbox());
      allow list: if isAuthenticated() && (isSuperAdmin() || (resource.data.orgId != '' && isFinance(resource.data.orgId)));
      allow create: if isAuthenticated() &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.get('attempts', 0) == 0 &&
        request.resource.data.get('maxAttempts', 0) <= 10 &&
        (isSuperAdmin() || (
          request.resource.data.orgId is string && request.resource.data.orgId != '' &&
          isOrgMember(request.resource.data.orgId) &&
          request.resource.data.recipients is list &&
          request.resource.data.recipients.size() > 0 && request.resource.data.recipients.size() <= 50 &&
          (isRequestEvent(request.resource.data) || isTestEvent(request.resource.data)) &&
          deliveryOk(request.resource.data)
        ));
      // Delivery-state transitions only (everything else is immutable), never out of a
      // terminal state, and each claim adds exactly one attempt, so an event is
      // delivered at most maxAttempts + 1 times.
      allow update: if isAuthenticated() && canManageOutbox() &&
        !(resource.data.status in ['sent', 'dead']) &&
        request.resource.data.status in ['sending', 'sent', 'failed', 'dead'] &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'attempts', 'leaseUntil', 'nextAttemptAt', 'lastError', 'deliveredTo', 'sentAt', 'updatedAt']) &&
        (request.resource.data.get('attempts', 0) == resource.data.get('attempts', 0) ||
          (request.resource.data.status == 'sending' &&
            request.resource.data.get('attempts', 0) == resource.data.get('attempts', 0) + 1)) &&
        request.resource.data.get('attempts', 0) <= resource.data.get('maxAttempts', 6) + 1;
      allow delete: if isSuperAdmin();
    }

    // Trigger-Email extension queue. A mail document is only ever the delivery of one
    // recipient of an outbox event currently claimed for sending: same recipient,
    // content and sender as the event, deterministic id, no cc/bcc/attachments.
    match /mail/{mailId} {
      function outboxPath(eventId) {
        return /databases/$(database)/documents/outbox/$(eventId);
      }

      function canDispatch(ev) {
        return isSuperAdmin() || ev.get('createdBy', null) == request.auth.uid || isFinance(ev.orgId);
      }

      function isDeliveryOf(m, ev) {
        return ev.channel == 'firestore_mail' && ev.status == 'sending' && canDispatch(ev) &&
          m.keys().hasOnly(['to', 'message', 'from', 'replyTo', 'metadata']) &&
          m.to is list && m.to.size() == 1 && m.to[0] in ev.recipients &&
          !(m.to[0] in ev.get('deliveredTo', [])) &&
          mailId == (m.metadata.eventId + ':' + m.to[0]).replace('[^A-Za-z0-9_-]', '_') &&
          m.message.keys().hasOnly(['subject', 'html', 'text']) &&
          m.message.subject == ev.message.subject &&
          m.message.html == ev.message.html &&
          m.message.get('text', '') == ev.message.get('text', '') &&
          m.from == '"' + ev.meta.senderName + '" <' + ev.meta.senderEmail + '>' &&
          m.replyTo == ev.meta.replyTo;
      }

      allow get: if isAuthenticated() && (
        isMissing() || isSuperAdmin() || (
          resource.data.metadata.eventId is string &&
          exists(outboxPath(resource.data.metadata.eventId)) &&
          canDispatch(get(outboxPath(resource.data.metadata.eventId)).data)
        )
      );
      allow create: if isAuthenticated() &&
        request.resource.data.metadata.eventId is string &&
        request.resource.data.metadata.eventId.matches('[^/]+') &&
        exists(outboxPath(request.resource.data.metadata.eventId)) &&
        isDeliveryOf(request.resource.data, get(outboxPath(request.resource.data.metadata.eventId)).data);
      allow update, delete: if false;
    }

    // =========================================================================
    // 15b. LEGACY RESTORE MARKERS (src/domain/legacyRecovery.ts)
    //      One permanent marker per record restored from a browser's old local data,
    //      so a restored record that is later deleted on purpose never comes back.
    // =========================================================================
    match /legacyRestores/{markerId} {
      // A marker is written only by the restore it records (restoreRecord: record + marker in
      // one transaction): its id is <collection>__<docId> of a restorable collection, and that
      // record is created by this very commit in the marker's company. So nobody can block the
      // restore of a record (of their own company or another's) with a marker for nothing.
      function restoredRecordPath() {
        return /databases/$(database)/documents/$(request.resource.data.collection)/$(request.resource.data.docId);
      }
      function marksRestoreInCommit() {
        let m = request.resource.data;
        return m.get('collection', '') in ['visaRequests', 'requests', 'departments', 'services', 'providers'] &&
          m.get('docId', '') is string && m.docId != '' && m.docId.matches('[^/]+') &&
          markerId == m.collection + '__' + m.docId &&
          !exists(restoredRecordPath()) &&
          getAfter(restoredRecordPath()) != null &&
          getAfter(restoredRecordPath()).data.get('orgId', '') == m.orgId;
      }
      // A marker tells which record of which company was restored, by whom: its company only
      // (a missing marker reads as missing for everyone: restoreRecord checks it first).
      allow get: if isAuthenticated() && (isMissing() || isOrgMember(resource.data.get('orgId', '')));
      allow create: if isAuthenticated() && request.resource.data.restoredBy == request.auth.uid &&
        (isSuperAdmin() || (request.resource.data.get('orgId', '') is string && request.resource.data.get('orgId', '') != '' &&
          marksRestoreInCommit() && isOrgMember(request.resource.data.orgId)));
      allow update: if false;
      // The platform owner may clear a marker (e.g. one written before markers were bound).
      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 16. SHARED SYSTEM SETTINGS (email notification settings)
    // =========================================================================
    match /system_settings/{settingId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && (
        settingId in ['email_notifications', 'notification_recipients'] && exists(profilePath()) &&
        get(profilePath()).data.get('active', true) != false && get(profilePath()).data.get('orgId', '') != ''
      ));
      allow write: if isSuperAdmin();
    }

    // =========================================================================
    // 17. ATTACHMENTS stored IN Firestore (invoices, visa documents, custody receipts)
    //     The project is on the Spark plan, which has no Cloud Storage. A file is
    //     attachments/{id} (metadata) + attachments/{id}/chunks/{index} (base64 slices
    //     of <= 700,000 characters); records keep `fsattach://<id>`. Upload order:
    //     metadata (complete: false) -> chunks -> complete: true (src/lib/attachmentsCore.ts).
    // =========================================================================
    //     An attachment id is single-use: deleting the metadata writes
    //     attachmentTombstones/{id} in the same batch, and no attachment is ever created
    //     under an id that has a tombstone. So the file behind a saved fsattach:// link can
    //     be removed, but never swapped for other content (delete + re-create the same id).
    match /attachments/{attachmentId} {
      function attachmentFields() {
        return ['id', 'orgId', 'name', 'mimeType', 'size', 'chunkCount', 'createdBy', 'createdAt', 'complete'];
      }
      function tombstonePath() {
        return /databases/$(database)/documents/attachmentTombstones/$(attachmentId);
      }

      // Keep in step with MAX_ATTACHMENT_BYTES / ALLOWED_ATTACHMENT_MIME_TYPES (attachmentsCore.ts).
      function isNewAttachment(a) {
        return a.keys().hasAll(attachmentFields()) && a.keys().hasOnly(attachmentFields()) &&
          a.id == attachmentId &&
          a.orgId is string && a.orgId != '' &&
          a.createdBy == request.auth.uid &&
          a.complete == false &&
          a.name is string && a.name.size() > 0 && a.name.size() <= 255 &&
          a.mimeType in ['application/pdf', 'image/png', 'image/jpeg'] &&
          a.size is int && a.size > 0 && a.size <= 10485760 &&
          a.chunkCount is int && a.chunkCount > 0 && a.chunkCount <= 32 &&
          a.createdAt is string;
      }

      // Members of the attachment's company (and super admins) read it. A missing id is
      // refused like another company's attachment (resource is null), so nothing leaks.
      allow get: if isAuthenticated() && (isSuperAdmin() || isOrgMember(resource.data.orgId));
      allow list: if isSuperAdmin();
      // Never under an id that was used before: tombstones are never removed, so
      // existsAfter also covers one written in this very batch.
      allow create: if isAuthenticated() && isNewAttachment(request.resource.data) &&
        isOrgMember(request.resource.data.orgId) &&
        !existsAfter(tombstonePath());
      // The only change ever allowed: its creator marks the upload complete, once its last
      // chunk exists. Nothing else (name, company, size, type, owner) can change.
      allow update: if isAuthenticated() &&
        resource.data.createdBy == request.auth.uid &&
        resource.data.complete == false &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['complete']) &&
        request.resource.data.complete == true &&
        isOrgMember(resource.data.orgId) &&
        exists(/databases/$(database)/documents/attachments/$(attachmentId)/chunks/$(string(resource.data.chunkCount - 1)));
      // Its creator (while still a member of that company), the company's admins and super admins,
      // always together with its tombstone (same batch), so the id can never be created again.
      allow delete: if isAuthenticated() && (
        isSuperAdmin() ||
        isOrgAdmin(resource.data.orgId) ||
        (resource.data.createdBy == request.auth.uid && isOrgMember(resource.data.orgId))
      ) && existsAfter(tombstonePath());

      match /chunks/{chunkId} {
        function parentPath() {
          return /databases/$(database)/documents/attachments/$(attachmentId);
        }
        function parent() {
          return get(parentPath()).data;
        }

        // Same readers as the metadata. Under a missing parent only super admins (cleaning up
        // leftovers) read anything.
        allow get, list: if isAuthenticated() && (isSuperAdmin() || (exists(parentPath()) && isOrgMember(parent().orgId)));
        // Only the uploader, only while the upload is not complete, only the chunk ids the
        // metadata announced (0 .. chunkCount-1, id == index), never rewritten (no update).
        allow create: if isAuthenticated() && exists(parentPath()) &&
          parent().createdBy == request.auth.uid &&
          parent().complete == false &&
          isOrgMember(parent().orgId) &&
          request.resource.data.keys().hasAll(['index', 'data']) &&
          request.resource.data.keys().hasOnly(['index', 'data']) &&
          request.resource.data.index is int &&
          request.resource.data.index >= 0 &&
          request.resource.data.index < parent().chunkCount &&
          chunkId == string(request.resource.data.index) &&
          request.resource.data.data is string &&
          request.resource.data.data.size() > 0 &&
          request.resource.data.data.size() <= 700000;
        allow update: if false;
        // Deleted together with (before) the metadata, by whoever may delete the attachment.
        // A complete file never loses single chunks: only in the batch that deletes its
        // metadata. Super admins may also clear chunks left without metadata.
        allow delete: if isAuthenticated() && (
          isSuperAdmin() || (
            exists(parentPath()) && (
              isOrgAdmin(parent().orgId) ||
              (parent().createdBy == request.auth.uid && isOrgMember(parent().orgId))
            ) &&
            (parent().complete == false || !existsAfter(parentPath()))
          )
        );
      }
    }

    // Ids of deleted attachments (see 17). Written only in the batch that deletes
    // attachments/{id} (whose delete rule decides who may), never changed or removed.
    match /attachmentTombstones/{attachmentId} {
      function deletedAttachmentPath() {
        return /databases/$(database)/documents/attachments/$(attachmentId);
      }
      allow get, list: if isSuperAdmin();
      allow create: if isAuthenticated() &&
        exists(deletedAttachmentPath()) && !existsAfter(deletedAttachmentPath()) &&
        request.resource.data.keys().hasAll(['orgId', 'deletedBy', 'deletedAt']) &&
        request.resource.data.keys().hasOnly(['orgId', 'deletedBy', 'deletedAt']) &&
        request.resource.data.orgId == get(deletedAttachmentPath()).data.orgId &&
        request.resource.data.deletedBy == request.auth.uid &&
        request.resource.data.deletedAt is string;
      allow update, delete: if false;
    }
  }
}
